<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Verification</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/verify/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="configurazione">
      <h2>Configuration</h2>
      <form method="POST" action="/verify/config" class="form">
        <label>
          Role to give for Sub
          <select name="subGiveRoleId">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.subGiveRoleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Role to give for Domme
          <select name="dommeGiveRoleId">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.dommeGiveRoleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Role to give for Maledom
          <select name="maledomGiveRoleId">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.maledomGiveRoleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Role to remove (shared across the three types)
          <select name="removeRoleId">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.removeRoleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Verification report channel
          <select name="reportChannelId">
            <option value="">— none —</option>
            <% textChannels.forEach((ch) => { %>
              <option value="<%= ch.id %>" <%= ch.id === config.reportChannelId ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Allowed role (in addition to anyone with "Manage Roles")
          <select name="allowedRoleId">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.allowedRoleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn-primary-sm">Save</button>
      </form>
    </section>

    <section class="panel" data-card-id="ruoli-sub">
      <h2>Sub roles</h2>
      <p class="hint">Set of roles checked when verifying as Sub: if the member has none of them, the default role is assigned automatically.</p>
      <form method="POST" action="/verify/subroles/config" class="form">
        <% if (roles.length > 0) { %>
          <fieldset>
            <legend>Roles in the set</legend>
            <% roles.forEach((r) => { %>
              <label class="checkbox-label">
                <input type="checkbox" name="subRoleIds" value="<%= r.id %>" <%= subRoleIds.includes(r.id) ? 'checked' : '' %> />
                <%= r.name %>
              </label>
            <% }) %>
          </fieldset>
        <% } %>
        <label>
          Default role (assigned if the member has none of the roles above)
          <select name="defaultSubRoleId">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.defaultSubRoleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn-primary-sm">Save</button>
      </form>
    </section>

    <section class="panel" data-card-id="verifica-un-utente">
      <h2>Verify a user</h2>
      <% if (members.length === 0) { %>
        <p class="hint">No members available.</p>
      <% } else { %>
        <form method="POST" action="/verify/issue" class="form">
          <label>
            User
            <select name="userId" required>
              <option value="" disabled selected>Choose…</option>
              <% members.forEach((m) => { %>
                <option value="<%= m.id %>"><%= m.label %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Type
            <select name="type" required>
              <% typeChoices.forEach((t) => { %>
                <option value="<%= t.value %>"><%= t.label %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Verification
            <textarea name="verification" rows="2" maxlength="500" required></textarea>
          </label>
          <label>
            Social (optional for Sub, required in practice for Domme/Maledom)
            <input type="text" name="social" maxlength="200" />
          </label>
          <button type="submit" class="btn-primary">Verify</button>
        </form>
      <% } %>
    </section>

    <section class="panel" data-card-id="report-recenti">
      <h2>Recent reports (<%= recentReports.length %><%= recentReportsTruncated ? '+' : '' %>)</h2>
      <% if (recentReports.length === 0) { %>
        <p class="hint">No reports recorded yet.</p>
      <% } else { %>
        <% recentReports.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= r.userLabel %> — <%= r.typeLabel %></span>
              <span class="config-meta">
                <%= r.dateLabel %> · verified by <%= r.moderatorLabel %>
                <% if (r.social) { %> · <%= r.social %><% } %>
              </span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/verify/<%= r.id %>/edit" class="form">
                      <label>
                        Field
                        <select name="field" required>
                          <option value="verification">Verification</option>
                          <option value="social">Social</option>
                        </select>
                      </label>
                      <label>
                        New value
                        <textarea name="value" rows="2" maxlength="500" required><%= r.verification %></textarea>
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
              </div>
            </div>
            <p class="hint"><%= r.verification %></p>
          </div>
        <% }) %>
        <% if (recentReportsTruncated) { %>
          <p class="hint">List truncated to the 100 most recent.</p>
        <% } %>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
