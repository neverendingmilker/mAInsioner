<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Reaction Limit</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/reactionlimit/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <section class="panel">
      <h2>Canali con limite (<%= channels.length %>)</h2>
      <% if (channels.length === 0) { %>
        <p class="hint">Nessun canale configurato.</p>
      <% } else { %>
        <% channels.forEach((c) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= c.channelName %></span>
              <span class="config-meta">
                max <%= c.reactionLimit %>/thread<%= c.ignoreFirstPost ? ' (post iniziale escluso)' : '' %>
              </span>
              <form method="POST" action="/reactionlimit/remove" onsubmit="return confirm('Rimuovere il limite da questo canale?');">
                <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                <button type="submit" class="btn-danger-sm">Rimuovi</button>
              </form>
            </div>
            <details class="config-edit">
              <summary>Modifica</summary>
              <form method="POST" action="/reactionlimit/add" class="form">
                <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                <label>
                  Reazioni massime per persona, per thread
                  <input type="number" name="reactionLimit" min="1" max="100" value="<%= c.reactionLimit %>" required />
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="ignoreFirstPost" <%= c.ignoreFirstPost ? 'checked' : '' %> />
                  Non contare le reazioni sul messaggio iniziale del thread
                </label>
                <button type="submit" class="btn-primary-sm">Salva</button>
              </form>
            </details>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel">
      <h2>Aggiungi limite</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">Nessun canale disponibile.</p>
      <% } else { %>
        <form method="POST" action="/reactionlimit/add" class="form">
          <label>
            Canale (i thread al suo interno erediteranno il limite)
            <select name="channelId" required>
              <option value="" disabled selected>Scegli un canale…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Reazioni massime per persona, per thread
            <input type="number" name="reactionLimit" min="1" max="100" value="<%= defaultLimit %>" required />
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="ignoreFirstPost" />
            Non contare le reazioni sul messaggio iniziale del thread
          </label>
          <button type="submit" class="btn-primary">Aggiungi limite</button>
        </form>
      <% } %>
    </section>
  </main>
</div>
<%- include('partials/footer') %>
