<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Highlight</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/highlight/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="impostazioni-universali">
      <h2>Global settings</h2>
      <p class="hint">
        Highlight is a personal feature: each user manages their own words/phrases, channel mode (exclude/only
        these), and ignored users list on Discord with <code>/highlight</code> — no one, not even an Admin or a
        Mod, can see or edit anyone else's list from here.
      </p>
      <p class="hint">
        The only server-wide setting is the switch above: turning it off stops the feature from checking
        messages and sending notifications for every user in the server, but their saved words stay intact
        and become active again as soon as you turn it back on.
      </p>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
