<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Server Backup</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/serverbackup/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="backup-di-questo-server">
      <h2>Backups of this server (<%= snapshots.length %>)</h2>
      <p class="hint">A backup can be restored more than once without risk: it never deletes or overwrites anything that already exists, it only creates what's missing (matched by name).</p>
      <% if (snapshots.length === 0) { %>
        <p class="hint">No backups created yet.</p>
      <% } else { %>
        <% snapshots.forEach((s) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">#<%= s.id %> — <%= s.label %></span>
              <span class="config-meta">
                created by <%= s.createdByLabel %> on <%= s.createdAtLabel %> —
                <%= s.assetCounts.emoji %> emoji, <%= s.assetCounts.sticker %> stickers, <%= s.assetCounts.soundboard %> sounds
              </span>
              <form method="POST" action="/serverbackup/<%= s.id %>/sync" onsubmit="return confirm('Reassign (additively only) the saved roles to members already in the server?');">
                <button type="submit" class="btn-secondary-sm">Sync roles</button>
              </form>
              <a href="/serverbackup/<%= s.id %>/restore" class="btn-primary-sm" style="text-decoration:none; display:inline-block;">Restore…</a>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="crea-nuovo-backup">
      <h2>Create new backup</h2>
      <form method="POST" action="/serverbackup/create" class="form">
        <label>
          Label (optional)
          <input type="text" name="label" maxlength="100" placeholder="e.g. before the restructuring" />
        </label>
        <label>
          What to include
          <select name="scope" required>
            <% scopes.forEach((s) => { %>
              <option value="<%= s %>" <%= s === 'all' ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn-primary">Create backup</button>
      </form>
      <p class="hint">"all" = everything (roles, channels, member roles, emoji/stickers/soundboard). With "assets" this can take a while if the server has a lot of them — it downloads each file one at a time.</p>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
