<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Restore backup #<%= snapshotId %></h1>
    </div>

    <section class="panel">
      <h2><%= preview.label || '(no label)' %></h2>
      <p class="hint">Originally from: <strong><%= preview.sourceGuildName %></strong></p>

      <% if (preview.missingBots.length > 0) { %>
        <p class="hint">⚠️ These bot/integration-managed roles aren't in this server yet — any channel permissions that reference them will be skipped until you invite them again:</p>
        <ul>
          <% preview.missingBots.forEach((name) => { %>
            <li><%= name %></li>
          <% }) %>
        </ul>
      <% } %>

      <p class="hint">Restoring doesn't delete or overwrite anything — it only creates what's missing, matched by name. Safe to run more than once.</p>

      <form method="POST" action="/serverbackup/<%= snapshotId %>/restore" class="form" onsubmit="return confirm('Confirm the restore? Real roles/channels/assets will be created on this server.');">
        <label>
          What to restore
          <select name="scope" required>
            <% scopes.forEach((s) => { %>
              <option value="<%= s %>" <%= s === selectedScope ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn-primary">Confirm restore</button>
      </form>
      <p class="hint"><a href="/serverbackup">← Cancel, back to the list</a></p>
    </section>
  </main>
</div>
<%- include('partials/footer') %>
