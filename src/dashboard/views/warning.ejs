<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Warnings</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/warning/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="configurazione">
      <h2>Configuration</h2>
      <form method="POST" action="/warning/config" class="form">
        <label>
          Role 1 (first warning)
          <select name="role1Id">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.role1Id ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Role 2 (second warning)
          <select name="role2Id">
            <option value="">— none —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.role2Id ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Warning list channel
          <select name="channelId">
            <option value="">— none —</option>
            <% textChannels.forEach((ch) => { %>
              <option value="<%= ch.id %>" <%= ch.id === config.channelId ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn-primary-sm">Save</button>
      </form>
      <p class="hint">The two roles must be set together (or neither). The channel is independent.</p>
    </section>

    <section class="panel" data-card-id="assegna-warning">
      <h2>Assign warning/verbal</h2>
      <p class="hint">Warning: assigns a role according to the configured scale, and also accepts the ID of someone who has left the server (still logged, without a role). Verbal: just a note in the warning channel, no role — requires the user to still be in the server.</p>
      <form method="POST" action="/warning/assign" class="form">
        <div>
          <label class="checkbox-label">
            <input type="radio" name="type" value="warning" checked />
            Regular warning
          </label>
          <label class="checkbox-label">
            <input type="radio" name="type" value="verbal" />
            Verbal
          </label>
        </div>
        <label>
          User (Discord ID, or type the name to search)
          <input type="text" name="targetUserId" list="warning-members-list" pattern="\d{17,20}" required placeholder="e.g. 123456789012345678 or start typing the name" />
          <datalist id="warning-members-list">
            <% members.forEach((m) => { %>
              <option value="<%= m.id %>"><%= m.label %></option>
            <% }) %>
          </datalist>
        </label>
        <label>
          Reason
          <textarea name="reason" rows="2" maxlength="300" required></textarea>
        </label>
        <label>
          Date (empty = today)
          <input type="date" name="date" />
        </label>
        <button type="submit" class="btn-primary">Assign</button>
      </form>
    </section>

    <section class="panel" data-card-id="i-miei-warning-verbali-modificabili">
      <h2>My editable warnings/verbals (<%= editableRows.length %>)</h2>
      <p class="hint">You can only edit the ones you issued.</p>
      <% if (editableRows.length === 0) { %>
        <p class="hint">You haven't issued any warnings/verbals yet.</p>
      <% } else { %>
        <% editableRows.forEach((w) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= w.label %></span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/warning/<%= w.id %>/edit" class="form">
                      <label>
                        Reason
                        <textarea name="reason" rows="2" maxlength="300" required><%= w.reason %></textarea>
                      </label>
                      <label>
                        Date
                        <input type="date" name="date" value="<%= w.dateIso %>" />
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="elenco-recente">
      <h2>Recent list (<%= recentWarnings.length %><%= recentWarningsTruncated ? '+' : '' %>)</h2>
      <% if (recentWarnings.length === 0) { %>
        <p class="hint">No warnings logged yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>User</th><th>Type</th><th>Reason</th><th>Role</th><th>Date</th><th>Issued by</th></tr></thead>
          <tbody>
            <% recentWarnings.forEach((w) => { %>
              <tr>
                <td><%= w.userLabel %></td>
                <td><%= w.typeLabel %></td>
                <td><%= w.reason %></td>
                <td><%= w.roleLabel || '—' %></td>
                <td><%= w.dateLabel %></td>
                <td><%= w.issuedByLabel %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (recentWarningsTruncated) { %>
          <p class="hint">List truncated to the 100 most recent.</p>
        <% } %>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
