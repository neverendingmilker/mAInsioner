<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Incident Counter</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/incident/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="stato-attuale">
      <h2>Current status</h2>
      <div class="cards">
        <div class="card">
          <div class="card-label">Days since last incident</div>
          <div class="card-value"><%= count %></div>
        </div>
        <div class="card">
          <div class="card-label">Sign channel</div>
          <div class="card-value" style="font-size: 16px;"><%= channelName || 'Not configured' %></div>
        </div>
      </div>
      <p class="hint">The count goes up by 1 automatically every day (scheduling already active) — use "Reset" as soon as an incident happens.</p>
    </section>

    <section class="panel" data-card-id="canale-cartello">
      <h2>Sign channel</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">No text channels available.</p>
      <% } else { %>
        <form method="POST" action="/incident/channel" class="form">
          <label>
            Channel where the sign gets posted/updated
            <select name="channelId" required>
              <option value="" disabled <%= !channelId ? 'selected' : '' %>>Choose a channel…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>" <%= ch.id === channelId ? 'selected' : '' %>><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-primary-sm">Save channel</button>
        </form>
      <% } %>
    </section>

    <section class="panel" data-card-id="modifica-contatore">
      <h2>Edit counter</h2>
      <form method="POST" action="/incident/set" class="form">
        <label>
          New value
          <input type="number" name="count" min="0" value="<%= count %>" required />
        </label>
        <button type="submit" class="btn-primary-sm">Set value</button>
      </form>
      <form method="POST" action="/incident/reset" onsubmit="return confirm('Reset the counter to 0?');" style="margin-top: 10px;">
        <button type="submit" class="btn-danger-sm">Reset to 0 (an incident just happened)</button>
      </form>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
