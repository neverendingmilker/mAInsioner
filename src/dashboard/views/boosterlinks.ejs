<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Booster Links</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/boosterlinks/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="ruoli-collegati">
      <h2>Ruoli collegati (<%= links.length %>)</h2>
      <% if (links.length === 0) { %>
        <p class="hint">Nessun ruolo personalizzato collegato a un booster.</p>
      <% } else { %>
        <% links.forEach((l) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">
                <%= l.userLabel %>
                <% if (l.isMod) { %><span class="badge badge-mod">Mod</span><% } %>
                <% if (l.isOgFren) { %><span class="badge badge-og-fren">OG/Fren</span><% } %>
              </span>
              <span class="config-meta"><%= l.roleLabel %><%= l.isBooster ? '' : ' — non sta più boostando' %></span>
              <div class="card-actions">
                <% if (roles.length > 0) { %>
                  <details>
                    <summary class="btn-icon-sm" title="Modifica">✎</summary>
                    <div class="card-edit-popover">
                      <form method="POST" action="/boosterlinks/edit" class="form">
                        <input type="hidden" name="userId" value="<%= l.userId %>" />
                        <input type="hidden" name="oldRoleId" value="<%= l.roleId %>" />
                        <label>
                          Nuovo ruolo da tracciare al posto di quello attuale
                          <select name="newRoleId" required>
                            <% roles.forEach((r) => { %>
                              <option value="<%= r.id %>" <%= r.id === l.roleId ? 'selected' : '' %>><%= r.name %></option>
                            <% }) %>
                          </select>
                        </label>
                        <button type="submit" class="btn-primary-sm">Salva</button>
                      </form>
                    </div>
                  </details>
                <% } %>
                <form method="POST" action="/boosterlinks/remove" onsubmit="return confirm('Smettere di tracciare questo ruolo? Il ruolo non verrà rimosso dall\'utente.');">
                  <input type="hidden" name="userId" value="<%= l.userId %>" />
                  <input type="hidden" name="roleId" value="<%= l.roleId %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Rimuovi">✕</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="ruoli-esenti">
      <h2>Ruoli esenti (<%= exemptRoles.length %>)</h2>
      <p class="hint">I membri con uno qualsiasi di questi ruoli non vengono mai toccati dalla rimozione automatica, indipendentemente dal boost.</p>
      <% if (exemptRoles.length === 0) { %>
        <p class="hint">Nessun ruolo esente configurato.</p>
      <% } else { %>
        <% exemptRoles.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= r.name %></span>
              <form method="POST" action="/boosterlinks/exempt/remove" onsubmit="return confirm('Rimuovere questo ruolo dagli esenti?');" class="card-actions">
                <input type="hidden" name="roleId" value="<%= r.id %>" />
                <button type="submit" class="btn-icon-sm btn-icon-danger" title="Rimuovi">✕</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
      <% if (allRoles.length > 0) { %>
        <form method="POST" action="/boosterlinks/exempt/add" class="form">
          <label>
            Aggiungi ruoli esenti
            <select name="roleIds" multiple required size="<%= Math.min(allRoles.length, 8) %>">
              <% allRoles.forEach((r) => { %>
                <option value="<%= r.id %>"><%= r.name %></option>
              <% }) %>
            </select>
          </label>
          <p class="hint">Tieni premuto Ctrl (o ⌘ su Mac) per selezionarne più di uno.</p>
          <button type="submit" class="btn-primary">Aggiungi ruoli esenti</button>
        </form>
      <% } %>
    </section>

    <%# Admin-only: which of the server's own roles gets an "OG/Fren" badge next to a
        linked booster's name above. Not hardcoded (unlike the "Mod" badge, which reuses the
        server's existing /modrole setting) — picked here from a plain role list, same
        pattern as the exempt-roles picker just above. %>
    <% if (typeof role !== 'undefined' && role === 'admin') { %>
      <section class="panel" data-card-id="badge-og-fren">
        <h2>Badge OG/Fren</h2>
        <p class="hint">Il ruolo scelto qui sotto fa comparire un badge "OG/Fren" accanto al nome di chi lo possiede, nella lista "Ruoli collegati" qui sopra.</p>
        <% if (allRoles.length === 0) { %>
          <p class="hint">Nessun ruolo disponibile.</p>
        <% } else { %>
          <form method="POST" action="/boosterlinks/og-fren-role/config" class="form">
            <label>
              Ruolo OG/Fren
              <select name="ogFrenRoleId">
                <option value="">— nessuno —</option>
                <% allRoles.forEach((r) => { %>
                  <option value="<%= r.id %>" <%= r.id === ogFrenRoleId ? 'selected' : '' %>><%= r.name %></option>
                <% }) %>
              </select>
            </label>
            <button type="submit" class="btn-primary-sm">Salva</button>
          </form>
        <% } %>
      </section>
    <% } %>
</div>
  </main>
</div>
<%- include('partials/footer') %>
