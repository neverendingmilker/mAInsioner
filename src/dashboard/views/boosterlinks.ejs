<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Booster Links</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/boosterlinks/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="ruoli-collegati">
      <h2>Linked roles (<%= links.length %>)</h2>
      <% if (links.length === 0) { %>
        <p class="hint">No custom role linked to a booster.</p>
      <% } else { %>
        <% links.forEach((l) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">
                <%= l.userLabel %>
                <% if (l.isMod) { %><span class="pill badge pill-accent">Mod</span><% } %>
                <% if (l.isOgFren) { %><span class="pill badge pill-success">OG/Fren</span><% } %>
                <% if (l.isPaused) { %><span class="pill badge pill-muted">Paused</span><% } %>
              </span>
              <span class="config-meta">
                <%= l.roleLabel %>
                <% if (l.isPaused) { %>
                   — no longer boosting, role removed (comes back automatically if they start again)
                <% } else if (!l.isBooster) { %>
                   — doesn't appear to be boosting anymore
                <% } %>
              </span>
              <div class="card-actions">
                <% if (roles.length > 0) { %>
                  <details>
                    <summary class="btn-icon-sm" title="Edit">✎</summary>
                    <div class="card-edit-popover">
                      <form method="POST" action="/boosterlinks/edit" class="form">
                        <input type="hidden" name="userId" value="<%= l.userId %>" />
                        <input type="hidden" name="oldRoleId" value="<%= l.roleId %>" />
                        <label>
                          New role to track instead of the current one
                          <select name="newRoleId" required>
                            <% roles.forEach((r) => { %>
                              <option value="<%= r.id %>" <%= r.id === l.roleId ? 'selected' : '' %>><%= r.name %></option>
                            <% }) %>
                          </select>
                        </label>
                        <button type="submit" class="btn-primary-sm">Save</button>
                      </form>
                    </div>
                  </details>
                <% } %>
                <form method="POST" action="/boosterlinks/remove" onsubmit="return confirm('Stop tracking this role? The role won\'t be removed from the user.');">
                  <input type="hidden" name="userId" value="<%= l.userId %>" />
                  <input type="hidden" name="roleId" value="<%= l.roleId %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="ruoli-esenti">
      <h2>Exempt roles (<%= exemptRoles.length %>)</h2>
      <p class="hint">Members with any of these roles are never touched by automatic removal, regardless of boost status.</p>
      <% if (exemptRoles.length === 0) { %>
        <p class="hint">No exempt roles configured.</p>
      <% } else { %>
        <% exemptRoles.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= r.name %></span>
              <form method="POST" action="/boosterlinks/exempt/remove" onsubmit="return confirm('Remove this role from the exempt list?');" class="card-actions">
                <input type="hidden" name="roleId" value="<%= r.id %>" />
                <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
      <% if (allRoles.length > 0) { %>
        <form method="POST" action="/boosterlinks/exempt/add" class="form">
          <label>
            Add exempt roles
            <select name="roleIds" multiple required size="<%= Math.min(allRoles.length, 8) %>">
              <% allRoles.forEach((r) => { %>
                <option value="<%= r.id %>"><%= r.name %></option>
              <% }) %>
            </select>
          </label>
          <p class="hint">Hold Ctrl (or ⌘ on Mac) to select more than one.</p>
          <button type="submit" class="btn-primary">Add exempt roles</button>
        </form>
      <% } %>
    </section>

    <%# The "Badge OG/Fren" config card that used to live here (pick which role shows the
        OG/Fren badge just above) was removed on request — the badge itself, and whichever
        role was configured before removal, keep working exactly as before; there's just no
        UI left to change it. ogFrenRoleId/ogFrenRoleName are still passed in by
        boosterlinks.js for that reason, even though nothing in this view reads them anymore. %>
</div>
  </main>
</div>
<%- include('partials/footer') %>
