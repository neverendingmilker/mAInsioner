<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Ruoli & Permessi</h1>
    </div>

    <%- include('partials/flash') %>

    <section class="panel">
      <form method="GET" action="/roleaudit" class="form">
        <label class="checkbox-label">
          <input type="checkbox" name="ignoreBots" value="1" <%= ignoreBots ? 'checked' : '' %> onchange="this.form.submit()" />
          Ignora ruoli/membri bot
        </label>
      </form>
    </section>

    <section class="panel">
      <h2>Permessi che richiedono 2FA (<%= mfa.roleMatches.length %>)</h2>
      <p class="hint">
        Permessi che Discord blocca per un account senza 2FA attivo, se il server ha "Richiedi 2FA per le azioni di
        moderazione" attivo (Impostazioni server → Sicurezza). Include i permessi ottenuti solo tramite un override
        di canale, non solo dalle impostazioni base del ruolo — quelli sono i più facili da non notare.
      </p>
      <% if (mfa.roleMatches.length === 0) { %>
        <p class="hint">✅ Nessun ruolo ha attualmente permessi che richiedono 2FA.</p>
      <% } else { %>
        <% mfa.roleMatches.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">🎭 <%= r.name %></span>
            </div>
            <% if (r.isAdmin) { %>
              <p>Administrator <em>(implica tutti gli altri permessi)</em></p>
            <% } else if (r.heldPermissions.length > 0) { %>
              <p><%= r.heldPermissions.join(', ') %></p>
            <% } %>
            <% if (r.overrides.length > 0) { %>
              <p>⚠️ Override di canale:</p>
              <ul>
                <% r.overrides.forEach((o) => { %><li><%= o %></li><% }) %>
                <% if (r.overridesHidden > 0) { %><li>...e altri <%= r.overridesHidden %> canali</li><% } %>
              </ul>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel">
      <h2>Permessi da moderatore (<%= mod.roleMatches.length + mod.memberMatches.length %>)</h2>
      <p class="hint">
        Controllo più ampio del precedente — include permessi comunemente considerati "da moderatore" che il
        requisito 2FA di Discord non copre (Audit log, Nickname, Espressioni, Timeout). Controlla anche gli override
        concessi a una singola persona su un canale, non solo ai ruoli — quelli non emergerebbero da un controllo
        basato solo sui ruoli.
      </p>
      <% if (mod.roleMatches.length === 0 && mod.memberMatches.length === 0) { %>
        <p class="hint">✅ Nessun ruolo o membro ha attualmente permessi da moderatore.</p>
      <% } else { %>
        <% mod.roleMatches.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">🎭 <%= r.name %></span>
            </div>
            <% if (r.isAdmin) { %>
              <p>Administrator <em>(implica tutti gli altri permessi)</em></p>
            <% } else if (r.heldPermissions.length > 0) { %>
              <p><%= r.heldPermissions.join(', ') %></p>
            <% } %>
            <% if (r.overrides.length > 0) { %>
              <p>⚠️ Override di canale:</p>
              <ul>
                <% r.overrides.forEach((o) => { %><li><%= o %></li><% }) %>
                <% if (r.overridesHidden > 0) { %><li>...e altri <%= r.overridesHidden %> canali</li><% } %>
              </ul>
            <% } %>
          </div>
        <% }) %>
        <% mod.memberMatches.forEach((m) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">👤 <%= m.displayName %> <em>(override individuale)</em></span>
            </div>
            <ul>
              <% m.entries.forEach((e) => { %><li><%= e %></li><% }) %>
              <% if (m.entriesHidden > 0) { %><li>...e altri <%= m.entriesHidden %> canali</li><% } %>
            </ul>
          </div>
        <% }) %>
      <% } %>
    </section>
  </main>
</div>
<%- include('partials/footer') %>
