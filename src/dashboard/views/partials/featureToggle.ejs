<%# Shared on/off control for a feature page's header, plus (Admin-only) the Mod-access
    checkbox, the "blocca modifiche" lock, and the card-reorder lock button. Wrapped in
    one div so `.page-header`'s flex layout (h1 vs. everything else) still only ever sees
    two children, regardless of how many of the pieces below actually render.
    Locals: `enabled` (bool), `toggleAction` (the feature's own POST /<feature>/toggle
    route — already expects `enabled` as the literal string "true"/"false"). A single
    checkbox works here without a hidden fallback field: every route already reads
    `req.body.enabled === 'true'`, and an unchecked checkbox simply omits `enabled` from
    the POST body entirely, which that comparison already treats as false. %>
<div class="feature-toggle-group">
  <form method="POST" action="<%= toggleAction %>" class="feature-toggle">
    <label class="switch">
      <input type="checkbox" name="enabled" value="true" <%= enabled ? 'checked' : '' %> onchange="this.form.submit()" />
      <span class="switch-slider"></span>
      <span class="switch-label"><%= enabled ? 'Attivo' : 'Disattivo' %></span>
    </label>
  </form>

  <%# Admin-only: whether this feature's page is also opened to the server's Mod role.
      Set globally by requireDashboardAccess (middleware/requireAdmin.js), not passed by
      each route — `role`/`currentFeatureKey`/`modAccessEnabled` are all res.locals
      already. Mods themselves never see this (their `role` is 'mod'), so they can't grant
      themselves more access. Toggling it doesn't affect what a Mod can do INSIDE an
      already-allowed feature — that's always full parity with Admin — only whether they
      can open this page at all. Label is always "Solo Admin" (doesn't flip to something
      like "Consentito ai Mod") — ON means mods are locked out, OFF means they're allowed;
      the checkbox name `soloAdmin` is intentionally the inverse of `modAccessEnabled`, so
      the route computes `allowed = req.body.soloAdmin !== 'true'` (unchecked → allowed). %>
  <% if (typeof role !== 'undefined' && role === 'admin' && typeof currentFeatureKey !== 'undefined' && currentFeatureKey) { %>
    <form method="POST" action="/mod-access/<%= currentFeatureKey %>/toggle" class="mod-access-toggle">
      <label class="switch">
        <input type="checkbox" name="soloAdmin" value="true" <%= modAccessEnabled ? '' : 'checked' %> onchange="this.form.submit()" />
        <span class="switch-slider"></span>
        <span class="switch-label">Solo Admin</span>
      </label>
    </form>
  <% } %>

  <%# Admin-only: freezes this feature's own add/edit/remove/reorder forms (its list of
      items) without touching the on/off switch above or base config (channel/role/
      schedule) — the feature keeps doing whatever it already does (e.g. QOTD keeps
      posting on schedule) while locked, only the dashboard's own CRUD forms are blocked
      (enforced centrally in requireDashboardAccess, for Admin and Mod alike). Posts to a
      route generic across every feature page — `featureLocked` local set by the same
      middleware. Label is always "Modificabile" (doesn't flip to "Bloccato") — ON means
      editable, OFF means locked; the checkbox name `editable` is intentionally the inverse
      of `featureLocked`, so the route computes `locked = req.body.editable !== 'true'`
      (unchecked → locked). %>
  <% if (typeof role !== 'undefined' && role === 'admin' && typeof currentFeatureKey !== 'undefined' && currentFeatureKey) { %>
    <form method="POST" action="/feature-lock/<%= currentFeatureKey %>/toggle" class="feature-lock-toggle">
      <label class="switch">
        <input type="checkbox" name="editable" value="true" <%= typeof featureLocked !== 'undefined' && featureLocked ? '' : 'checked' %> onchange="this.form.submit()" />
        <span class="switch-slider"></span>
        <span class="switch-label">Modificabile</span>
      </label>
    </form>
  <% } %>

  <%# Card-reorder support: `cardOrder` (the saved drag order for this page's panels) is
      always set by requireDashboardAccess, for both Admin and Mod, so the reorder applies
      for anyone viewing the page — only the lock button + drag handles that let you
      CHANGE it are Admin-only. See public/cardReorder.js and each view's `<div
      class="card-list" id="card-list">` wrapping its `.panel[data-card-id]` sections. %>
  <% if (typeof cardOrder !== 'undefined') { %>
    <script id="card-order-data" type="application/json"><%- JSON.stringify(cardOrder) %></script>
  <% } %>
  <% if (typeof role !== 'undefined' && role === 'admin' && typeof currentFeatureKey !== 'undefined' && currentFeatureKey) { %>
    <button type="button" id="card-lock-btn" class="card-lock-btn" data-locked="true" title="Sblocca per riordinare le card">🔒 Riordina card</button>
    <form id="card-reorder-form" method="POST" action="/card-order/<%= currentFeatureKey %>/reorder" style="display:none;">
      <input type="hidden" id="card-order-input" name="order" value="" />
    </form>
  <% } %>
</div>
<script src="/cardReorder.js"></script>
