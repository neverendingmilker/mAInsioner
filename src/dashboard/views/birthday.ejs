<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Birthday</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/birthday/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="configurazione">
      <h2>Configurazione</h2>
      <form method="POST" action="/birthday/config" class="form">
        <label>
          Ruolo compleanno (assegnato il giorno del compleanno)
          <select name="roleId">
            <option value="">— Nessuno —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.roleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Rimuovi il ruolo dopo (es. 30s, 10m, 24h, 3d — min 10s, max 30d)
          <input type="text" name="removeAfter" placeholder="<%= config.removeAfterLabel %>" />
        </label>
        <label>
          Canale auguri
          <select name="channelId">
            <option value="">— Nessuno —</option>
            <% textChannels.forEach((ch) => { %>
              <option value="<%= ch.id %>" <%= ch.id === config.channelId ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
        </label>
        <p class="hint">Ogni campo è indipendente — lascia vuoto/su "Nessuno" quello che non vuoi cambiare.</p>
        <button type="submit" class="btn-primary-sm">Salva</button>
      </form>
    </section>

    <section class="panel" data-card-id="compleanni-salvati">
      <h2>Compleanni salvati</h2>
      <% if (monthGroups.length === 0) { %>
        <p class="hint">Nessun compleanno salvato.</p>
      <% } else { %>
        <% monthGroups.forEach((g) => { %>
          <h3 class="month-heading"><%= g.monthLabel %></h3>
          <% g.entries.forEach((e) => { %>
            <div class="birthday-card">
              <div class="birthday-card-header">
                <span class="birthday-user"><%= e.userLabel %></span>
                <span class="birthday-date"><%= e.day %>/<%= e.month %><% if (e.year) { %>/<%= e.year %><% } %></span>
                <span class="birthday-countdown"><%= e.daysUntilLabel %></span>
              </div>
              <details class="birthday-edit">
                <summary>Modifica</summary>
                <% if (e.memberPresent) { %>
                  <form method="POST" action="/birthday/add" class="form">
                    <input type="hidden" name="userId" value="<%= e.userId %>" />
                    <label>
                      Giorno
                      <input type="number" name="day" min="1" max="31" value="<%= e.day %>" required />
                    </label>
                    <label>
                      Mese
                      <input type="number" name="month" min="1" max="12" value="<%= e.month %>" required />
                    </label>
                    <label>
                      Anno (opzionale)
                      <input type="number" name="year" min="1900" max="<%= new Date().getFullYear() %>" value="<%= e.year || '' %>" />
                    </label>
                    <button type="submit" class="btn-primary-sm">Salva</button>
                  </form>
                <% } else { %>
                  <p class="hint">Questo utente non è più nel server — la data non è modificabile, ma puoi comunque rimuovere la voce.</p>
                <% } %>
                <form method="POST" action="/birthday/remove" class="birthday-remove-form" onsubmit="return confirm('Rimuovere questo compleanno?');">
                  <input type="hidden" name="userId" value="<%= e.userId %>" />
                  <button type="submit" class="btn-danger-sm">Rimuovi</button>
                </form>
              </details>
            </div>
          <% }) %>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-aggiorna-compleanno">
      <h2>Aggiungi / aggiorna compleanno</h2>
      <% if (members.length === 0) { %>
        <p class="hint">Nessun membro disponibile.</p>
      <% } else { %>
        <form method="POST" action="/birthday/add" class="form">
          <label>
            Utente
            <select name="userId" required>
              <option value="" disabled selected>Scegli un utente…</option>
              <% members.forEach((m) => { %>
                <option value="<%= m.id %>"><%= m.label %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Giorno
            <input type="number" name="day" min="1" max="31" required />
          </label>
          <label>
            Mese
            <input type="number" name="month" min="1" max="12" required />
          </label>
          <label>
            Anno (opzionale)
            <input type="number" name="year" min="1900" max="<%= new Date().getFullYear() %>" />
          </label>
          <button type="submit" class="btn-primary">Salva</button>
        </form>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
