<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Roles & Permissions</h1>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
    <section class="panel" data-card-id="opzioni">
      <form method="GET" action="/roleaudit" class="form">
        <label class="checkbox-label">
          <input type="checkbox" name="ignoreBots" value="1" <%= ignoreBots ? 'checked' : '' %> onchange="this.form.submit()" />
          Ignore bot roles/members
        </label>
      </form>
    </section>

    <section class="panel" data-card-id="permessi-2fa">
      <h2>Permissions that require 2FA (<%= mfa.roleMatches.length %>)</h2>
      <p class="hint">
        Permissions Discord blocks for an account without 2FA enabled, if the server has "Require 2FA for moderator
        actions" on (Server Settings → Safety). Includes permissions granted only through a channel override,
        not just from the role's base settings — those are the easiest to miss.
      </p>
      <% if (mfa.roleMatches.length === 0) { %>
        <p class="hint">✅ No role currently has permissions that require 2FA.</p>
      <% } else { %>
        <% mfa.roleMatches.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">🎭 <%= r.name %></span>
            </div>
            <% if (r.isAdmin) { %>
              <p>Administrator <em>(implies every other permission)</em></p>
            <% } else if (r.heldPermissions.length > 0) { %>
              <p><%= r.heldPermissions.join(', ') %></p>
            <% } %>
            <% if (r.overrides.length > 0) { %>
              <p>⚠️ Channel overrides:</p>
              <ul>
                <% r.overrides.forEach((o) => { %><li><%= o %></li><% }) %>
                <% if (r.overridesHidden > 0) { %><li>...and <%= r.overridesHidden %> more channels</li><% } %>
              </ul>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="permessi-mod">
      <h2>Moderator-level permissions (<%= mod.roleMatches.length + mod.memberMatches.length %>)</h2>
      <p class="hint">
        A broader check than the one above — includes permissions commonly considered "moderator-level" that
        Discord's 2FA requirement doesn't cover (Audit Log, Nicknames, Expressions, Timeout). Also checks overrides
        granted to a single person on a channel, not just to roles — those wouldn't show up in a roles-only check.
      </p>
      <% if (mod.roleMatches.length === 0 && mod.memberMatches.length === 0) { %>
        <p class="hint">✅ No role or member currently has moderator-level permissions.</p>
      <% } else { %>
        <% mod.roleMatches.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">🎭 <%= r.name %></span>
            </div>
            <% if (r.isAdmin) { %>
              <p>Administrator <em>(implies every other permission)</em></p>
            <% } else if (r.heldPermissions.length > 0) { %>
              <p><%= r.heldPermissions.join(', ') %></p>
            <% } %>
            <% if (r.overrides.length > 0) { %>
              <p>⚠️ Channel overrides:</p>
              <ul>
                <% r.overrides.forEach((o) => { %><li><%= o %></li><% }) %>
                <% if (r.overridesHidden > 0) { %><li>...and <%= r.overridesHidden %> more channels</li><% } %>
              </ul>
            <% } %>
          </div>
        <% }) %>
        <% mod.memberMatches.forEach((m) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">👤 <%= m.displayName %> <em>(individual override)</em></span>
            </div>
            <ul>
              <% m.entries.forEach((e) => { %><li><%= e %></li><% }) %>
              <% if (m.entriesHidden > 0) { %><li>...and <%= m.entriesHidden %> more channels</li><% } %>
            </ul>
          </div>
        <% }) %>
      <% } %>
    </section>
    </div>
  </main>
</div>
<%- include('partials/footer') %>
