<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Autoresponder</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/autoresponder/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="canali-configurati">
      <h2>Canali configurati (<%= channels.length %>)</h2>
      <% if (channels.length === 0) { %>
        <p class="hint">Nessun canale configurato.</p>
      <% } else { %>
        <% channels.forEach((c) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= c.channelName %></span>
              <span class="config-meta"><%= c.emojisText %></span>
              <form method="POST" action="/autoresponder/remove" onsubmit="return confirm('Rimuovere l\'autoresponder da questo canale?');">
                <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                <button type="submit" class="btn-danger-sm">Rimuovi</button>
              </form>
            </div>
            <% if (c.contentFilter.attachment || c.contentFilter.videoLink || c.contentFilter.xLink) { %>
              <p class="hint">
                Solo se:
                <% const filters = []; %>
                <% if (c.contentFilter.attachment) filters.push('ha un allegato immagine/gif/video'); %>
                <% if (c.contentFilter.videoLink) filters.push('linka un video'); %>
                <% if (c.contentFilter.xLink) filters.push('linka un post X/Twitter'); %>
                <%= filters.join(', o ') %>
              </p>
            <% } %>
            <% if (c.redirectBotId) { %>
              <p class="hint">Redirect: aspetta fino a <%= c.redirectWindowSeconds %>s un post del bot ID <%= c.redirectBotId %>, altrimenti reagisce al messaggio originale.</p>
            <% } %>
            <details class="config-edit">
              <summary>Modifica</summary>
              <form method="POST" action="/autoresponder/add" class="form">
                <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                <label>
                  Emoji (separate da spazio o virgola)
                  <input type="text" name="emojis" value="<%= c.emojisText %>" required />
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="attachment" <%= c.contentFilter.attachment ? 'checked' : '' %> />
                  Solo se ha un allegato immagine/gif/video
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="videoLink" <%= c.contentFilter.videoLink ? 'checked' : '' %> />
                  Solo se linka un video (es. YouTube)
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" name="xLink" <%= c.contentFilter.xLink ? 'checked' : '' %> />
                  Solo se linka un post X/Twitter
                </label>
                <label>
                  Redirect: ID del bot da aspettare (opzionale, lascia vuoto per disattivare)
                  <input type="text" name="redirectBotId" value="<%= c.redirectBotId || '' %>" />
                </label>
                <label>
                  Redirect: finestra d'attesa in secondi (1-<%= maxRedirectWindowSeconds %>, richiesta se sopra è compilato)
                  <input type="number" name="redirectWindowSeconds" min="1" max="<%= maxRedirectWindowSeconds %>" value="<%= c.redirectWindowSeconds || '' %>" />
                </label>
                <button type="submit" class="btn-primary-sm">Salva</button>
              </form>
            </details>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-autoresponder">
      <h2>Aggiungi autoresponder</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">Nessun canale disponibile.</p>
      <% } else { %>
        <form method="POST" action="/autoresponder/add" class="form">
          <label>
            Canale
            <select name="channelId" required>
              <option value="" disabled selected>Scegli un canale…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Emoji con cui reagire (separate da spazio o virgola, es. "🍕 🔥")
            <input type="text" name="emojis" placeholder="🍕" required />
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="attachment" />
            Solo se ha un allegato immagine/gif/video
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="videoLink" />
            Solo se linka un video (es. YouTube)
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="xLink" />
            Solo se linka un post X/Twitter
          </label>
          <label>
            Redirect: ID del bot da aspettare (opzionale)
            <input type="text" name="redirectBotId" placeholder="es. 123456789012345678" />
          </label>
          <label>
            Redirect: finestra d'attesa in secondi (1-<%= maxRedirectWindowSeconds %>, richiesta se sopra è compilato)
            <input type="number" name="redirectWindowSeconds" min="1" max="<%= maxRedirectWindowSeconds %>" />
          </label>
          <button type="submit" class="btn-primary">Crea autoresponder</button>
        </form>
        <p class="hint">Applicarlo a thread o forum invece che a un canale intero resta possibile solo via <code>/autoresponder add</code> su Discord.</p>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
