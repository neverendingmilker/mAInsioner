<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Sticky Messages</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/sticky/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="canali-con-messaggio-persistente">
      <h2>Channels with a persistent message (<%= stickies.length %>)</h2>
      <% if (stickies.length === 0) { %>
        <p class="hint">No channels configured.</p>
      <% } else { %>
        <% stickies.forEach((s) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= s.channelName %></span>
              <span class="config-meta">reappears after <%= s.repostDelayLabel %> of inactivity</span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/sticky/add" class="form">
                      <input type="hidden" name="channelId" value="<%= s.channelId %>" />
                      <label>
                        Message
                        <textarea name="content" rows="3" maxlength="4000" required><%= s.content %></textarea>
                      </label>
                      <label>
                        Delay before reappearing (e.g. 30s, 1m, 2m)
                        <input type="text" name="delay" value="<%= s.repostDelaySeconds %>s" required />
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                    <p class="hint">Saving deletes the old message and posts a new one — this can take a few seconds.</p>
                  </div>
                </details>
                <form method="POST" action="/sticky/remove" onsubmit="return confirm('Remove the persistent message from this channel?');">
                  <input type="hidden" name="channelId" value="<%= s.channelId %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-messaggio-persistente">
      <h2>Add persistent message</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">No text channels available.</p>
      <% } else { %>
        <form method="POST" action="/sticky/add" class="form">
          <label>
            Channel
            <select name="channelId" required>
              <option value="" disabled selected>Choose a channel…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Message
            <textarea name="content" rows="3" maxlength="4000" required></textarea>
          </label>
          <label>
            Delay before reappearing (optional, default <%= defaultDelaySeconds %>s) — e.g. 30s, 1m, 2m
            <input type="text" name="delay" placeholder="<%= defaultDelaySeconds %>s" />
          </label>
          <button type="submit" class="btn-primary">Create persistent message</button>
        </form>
        <p class="hint">Applying it to a single thread instead of a whole channel is still only possible via <code>/sticky add</code> on Discord.</p>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
