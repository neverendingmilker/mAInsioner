<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>WaifuWar LR</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/waifuwarlr/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="canali-configurati">
      <h2>Configured channels (<%= channels.length %>)</h2>
      <p class="hint">In each channel: post an image, then a message with just numbers (max 9 digits) to apply the reactions mapped below — the message with the numbers is then deleted.</p>
      <% if (channels.length === 0) { %>
        <p class="hint">No channels configured.</p>
      <% } else { %>
        <% channels.forEach((c) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= c.channelName %></span>
              <span class="config-meta">
                <% if (c.mappings.length === 0) { %>
                  no mappings yet
                <% } else { %>
                  <% c.mappings.forEach((m) => { %><%= m.digit %>→<%= m.emoji %> <% }) %>
                <% } %>
              </span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/waifuwarlr/setdigit" class="form">
                      <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                      <label>
                        Digits (comma-separated, e.g. "7,8,9")
                        <input type="text" name="digit" required placeholder="7,8,9" />
                      </label>
                      <label>
                        Matching emoji, same order (e.g. "🟢,🟡,🔴")
                        <input type="text" name="emoji" required placeholder="🟢,🟡,🔴" />
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/waifuwarlr/remove" onsubmit="return confirm('Remove this channel (and all its mappings)?');">
                  <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
            <% if (c.mappings.length > 0) { %>
              <table class="table">
                <thead><tr><th>Digit</th><th>Emoji</th><th></th></tr></thead>
                <tbody>
                  <% c.mappings.forEach((m) => { %>
                    <tr>
                      <td><%= m.digit %></td>
                      <td><%= m.emoji %></td>
                      <td>
                        <form method="POST" action="/waifuwarlr/removedigit" onsubmit="return confirm('Remove the mapping for digit <%= m.digit %>?');">
                          <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                          <input type="hidden" name="digit" value="<%= m.digit %>" />
                          <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-canale">
      <h2>Add channel</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">No channels available.</p>
      <% } else { %>
        <form method="POST" action="/waifuwarlr/add" class="form">
          <label>
            Channel
            <select name="channelId" required>
              <option value="" disabled selected>Choose a channel…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-primary">Add channel</button>
        </form>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
