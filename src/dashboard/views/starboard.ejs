<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Starboard</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/starboard/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="starboard">
      <h2>Starboard (<%= boards.length %>)</h2>
      <!-- Il lookback parte in background nello stesso processo del bot: la richiesta
           POST torna subito, la scansione vera e propria continua dopo — vedi
           /starboard/lookback e /starboard/lookback/status, starboardLookback.js. -->
      <% if (boards.length === 0) { %>
        <p class="hint">Nessuna starboard configurata.</p>
      <% } else { %>
        <% boards.forEach((b) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= b.name %></span>
              <span class="config-meta">
                <%= b.watchChannelLabel %> → <%= b.postChannelLabel %>, soglia <%= b.threshold %>+,
                <%= b.emojisDisplay %>, filtro: <%= b.contentTypeLabel %>
              </span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Lookback (scansiona messaggi recenti)">🔍</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/starboard/lookback" class="form">
                      <input type="hidden" name="name" value="<%= b.name %>" />
                      <label>
                        Messaggi da scansionare per canale (ignorato se scegli una data di inizio)
                        <input type="number" name="limit" min="1" max="<%= lookbackMaxLimit %>" value="<%= lookbackDefaultLimit %>" />
                      </label>
                      <label>
                        Inizio scansione
                        <select name="sinceMode">
                          <option value="none">Solo gli ultimi N messaggi (sopra)</option>
                          <option value="year_start">Dall'inizio dell'anno</option>
                          <option value="date">Da una data specifica</option>
                        </select>
                      </label>
                      <label>
                        Data di inizio (solo se "Da una data specifica", GG/MM/AAAA)
                        <input type="text" name="sinceDate" placeholder="15/03/2025" />
                      </label>
                      <label>
                        Data di fine, opzionale (GG/MM/AAAA, incluso quel giorno intero)
                        <input type="text" name="untilDate" placeholder="20/03/2025" />
                      </label>
                      <label>
                        Filtro contenuto per questa scansione (opzionale, altrimenti usa quello della starboard)
                        <select name="contentType">
                          <option value="">Usa il filtro della starboard (<%= b.contentTypeLabel %>)</option>
                          <% Object.entries(contentTypes).forEach(([value, label]) => { %>
                            <option value="<%= value %>"><%= label %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label>
                        Emoji per questa scansione (opzionale, altrimenti usa quelle della starboard)
                        <input type="text" name="emojis" placeholder="<%= b.emojisRaw %>" />
                      </label>
                      <label>
                        Soglia per questa scansione (opzionale, altrimenti <%= b.threshold %>)
                        <input type="number" name="threshold" min="<%= minThreshold %>" max="<%= maxThreshold %>" />
                      </label>
                      <% if (b.extraChannelChoices.length > 0) { %>
                        <fieldset>
                          <legend>Canali aggiuntivi da scansionare (oltre a <%= b.watchChannelLabel %>, max <%= maxLookbackChannels - 1 %>)</legend>
                          <% b.extraChannelChoices.forEach((ch) => { %>
                            <label class="checkbox-label">
                              <input type="checkbox" name="extraChannelIds" value="<%= ch.id %>" />
                              <%= ch.name %>
                            </label>
                          <% }) %>
                        </fieldset>
                      <% } %>
                      <button type="submit" class="btn-primary-sm">Avvia scansione</button>
                    </form>
                  </div>
                </details>
                <details>
                  <summary class="btn-icon-sm" title="Modifica">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/starboard/edit" class="form">
                      <input type="hidden" name="name" value="<%= b.name %>" />
                      <label>
                        Canale osservato
                        <select name="watchChannelId" required>
                          <% textChannels.forEach((ch) => { %>
                            <option value="<%= ch.id %>" <%= b.watchChannelId === ch.id ? 'selected' : '' %>><%= ch.name %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label>
                        Canale di destinazione
                        <select name="postChannelId" required>
                          <% textChannels.forEach((ch) => { %>
                            <option value="<%= ch.id %>" <%= b.postChannelId === ch.id ? 'selected' : '' %>><%= ch.name %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label>
                        Soglia reazioni
                        <input type="number" name="threshold" min="<%= minThreshold %>" max="<%= maxThreshold %>" value="<%= b.threshold %>" required />
                      </label>
                      <label>
                        Emoji (fino a <%= maxEmojis %>, oppure "any" per qualsiasi emoji)
                        <input type="text" name="emojis" value="<%= b.emojisRaw %>" required />
                      </label>
                      <label>
                        Tipo di contenuto
                        <select name="contentType" required>
                          <% Object.entries(contentTypes).forEach(([value, label]) => { %>
                            <option value="<%= value %>" <%= b.contentType === value ? 'selected' : '' %>><%= label %></option>
                          <% }) %>
                        </select>
                      </label>
                      <button type="submit" class="btn-primary-sm">Salva</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/starboard/remove" onsubmit="return confirm('Rimuovere questa starboard?');">
                  <input type="hidden" name="name" value="<%= b.name %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Rimuovi">✕</button>
                </form>
              </div>
            </div>
            <div
              class="lookback-status config-card-subtext"
              data-board-name="<%= b.name %>"
              data-status="<%= b.lookback ? b.lookback.status : '' %>"
              <%= b.lookback ? '' : 'hidden' %>
            >
              <span class="lookback-status-text">
                <% if (b.lookback) { %>
                  <% if (b.lookback.status === 'running') { %>
                    🔍 Scansione in corso… <%= b.lookback.scanned %> messaggi controllati, <%= b.lookback.qualified %> aggiunti finora (<%= b.lookback.channelsScanned %> canali).
                  <% } else if (b.lookback.status === 'done') { %>
                    ✅ Scansione completata: <%= b.lookback.scanned %> messaggi controllati, <%= b.lookback.qualified %> aggiunti alla starboard<%= b.lookback.errors > 0 ? ` (${b.lookback.errors} con errore)` : '' %>.
                  <% } else if (b.lookback.status === 'error') { %>
                    ⚠️ Scansione interrotta: <%= b.lookback.errorMessage %>
                  <% } %>
                <% } %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-starboard">
      <h2>Aggiungi starboard</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">Nessun canale disponibile.</p>
      <% } else { %>
        <form method="POST" action="/starboard/add" class="form">
          <label>
            Nome (identifica la starboard)
            <input type="text" name="name" required />
          </label>
          <label>
            Canale osservato
            <select name="watchChannelId" required>
              <option value="" disabled selected>Scegli…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Canale di destinazione
            <select name="postChannelId" required>
              <option value="" disabled selected>Scegli…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Soglia reazioni
            <input type="number" name="threshold" min="<%= minThreshold %>" max="<%= maxThreshold %>" value="3" required />
          </label>
          <label>
            Emoji (fino a <%= maxEmojis %>, es. "⭐" oppure "any" per qualsiasi emoji)
            <input type="text" name="emojis" placeholder="⭐" required />
          </label>
          <label>
            Tipo di contenuto
            <select name="contentType" required>
              <% Object.entries(contentTypes).forEach(([value, label]) => { %>
                <option value="<%= value %>" <%= value === 'any' ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-primary">Aggiungi starboard</button>
        </form>
      <% } %>
    </section>
</div>
  </main>
</div>
<script src="/starboardLookback.js"></script>
<%- include('partials/footer') %>
