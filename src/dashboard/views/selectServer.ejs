<%- include('partials/head') %>
<div class="login-page">
  <div class="login-card login-card-wide">
    <div class="brand">mAInsioner</div>
    <p>You're an Admin or Mod on more than one server the bot is in — choose which one to manage.</p>
    <div class="server-list">
      <% guilds.forEach((g) => { %>
        <form method="POST" action="/select-server" class="server-list-item">
          <input type="hidden" name="guildId" value="<%= g.id %>" />
          <button type="submit" class="server-list-btn">
            <% if (g.iconURL) { %><img src="<%= g.iconURL %>" alt="" class="guild-icon" /><% } %>
            <span><%= g.name %></span>
            <span class="pill role-badge <%= g.role === 'admin' ? 'pill-accent' : 'pill-success' %>"><%= g.role === 'admin' ? 'Admin' : 'Mod' %></span>
          </button>
        </form>
      <% }) %>
    </div>
    <a class="logout" href="/logout">Log out</a>
  </div>
</div>
<%- include('partials/footer') %>
