<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Anime Night</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/animenight/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="sessioni">
      <h2>Sessions (<%= sessions.length %>)</h2>
      <% if (sessions.length === 0) { %>
        <p class="hint">No sessions recorded.</p>
      <% } else { %>
        <% sessions.forEach((s) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">Mystery Anime Night <%= s.number %></span>
              <span class="config-meta"><%= s.date %> — <%= s.titles.length %> anime</span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/animenight/edit" class="form">
                      <input type="hidden" name="sessionDate" value="<%= s.date %>" />
                      <label>
                        Titles (comma or / separated)
                        <textarea name="titles" rows="2" required><%= s.titles.join(', ') %></textarea>
                      </label>
                      <label>
                        Date
                        <input type="date" name="date" value="<%= s.date %>" required />
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/animenight/remove" onsubmit="return confirm('Remove the entire session (all anime from this date)?');">
                  <input type="hidden" name="sessionDate" value="<%= s.date %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
            <p class="config-card-subtext"><%= s.titles.join(', ') %></p>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-anime">
      <h2>Add anime</h2>
      <form method="POST" action="/animenight/add" class="form">
        <label>
          Titles (comma or / separated, e.g. "Naruto, One Piece")
          <textarea name="titles" rows="2" required placeholder="Naruto, One Piece"></textarea>
        </label>
        <label>
          Date (empty = today)
          <input type="date" name="date" />
        </label>
        <button type="submit" class="btn-primary">Add anime</button>
      </form>
      <p class="hint">If the date matches an existing session, the titles are added to it instead of creating a new one.</p>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
