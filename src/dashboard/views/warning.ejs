<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Warnings</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/warning/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="configurazione">
      <h2>Configurazione</h2>
      <form method="POST" action="/warning/config" class="form">
        <label>
          Ruolo 1 (primo warning)
          <select name="role1Id">
            <option value="">— nessuno —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.role1Id ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Ruolo 2 (secondo warning)
          <select name="role2Id">
            <option value="">— nessuno —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.role2Id ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Canale elenco warning
          <select name="channelId">
            <option value="">— nessuno —</option>
            <% textChannels.forEach((ch) => { %>
              <option value="<%= ch.id %>" <%= ch.id === config.channelId ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn-primary-sm">Salva</button>
      </form>
      <p class="hint">I due ruoli vanno specificati insieme (o nessuno dei due). Il canale è indipendente.</p>
    </section>

    <section class="panel" data-card-id="assegna-warning">
      <h2>Assegna warning/verbale</h2>
      <p class="hint">Warning: assegna un ruolo secondo la scala configurata, e accetta anche l'ID di chi ha lasciato il server (registrato comunque, senza ruolo). Verbale: solo una nota nel canale warning, nessun ruolo — richiede che l'utente sia ancora nel server.</p>
      <form method="POST" action="/warning/assign" class="form">
        <div>
          <label class="checkbox-label">
            <input type="radio" name="type" value="warning" checked />
            Warning normale
          </label>
          <label class="checkbox-label">
            <input type="radio" name="type" value="verbal" />
            Verbale
          </label>
        </div>
        <label>
          Utente (ID Discord, oppure digita il nome per cercarlo)
          <input type="text" name="targetUserId" list="warning-members-list" pattern="\d{17,20}" required placeholder="es. 123456789012345678 o inizia a digitare il nome" />
          <datalist id="warning-members-list">
            <% members.forEach((m) => { %>
              <option value="<%= m.id %>"><%= m.label %></option>
            <% }) %>
          </datalist>
        </label>
        <label>
          Motivo
          <textarea name="reason" rows="2" maxlength="300" required></textarea>
        </label>
        <label>
          Data (vuoto = oggi)
          <input type="date" name="date" />
        </label>
        <button type="submit" class="btn-primary">Assegna</button>
      </form>
    </section>

    <section class="panel" data-card-id="i-miei-warning-verbali-modificabili">
      <h2>I miei warning/verbali modificabili (<%= editableRows.length %>)</h2>
      <p class="hint">Puoi modificare solo quelli che hai emesso tu.</p>
      <% if (editableRows.length === 0) { %>
        <p class="hint">Non hai ancora emesso nessun warning/verbale.</p>
      <% } else { %>
        <% editableRows.forEach((w) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= w.label %></span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Modifica">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/warning/<%= w.id %>/edit" class="form">
                      <label>
                        Motivo
                        <textarea name="reason" rows="2" maxlength="300" required><%= w.reason %></textarea>
                      </label>
                      <label>
                        Data
                        <input type="date" name="date" value="<%= w.dateIso %>" />
                      </label>
                      <button type="submit" class="btn-primary-sm">Salva</button>
                    </form>
                  </div>
                </details>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="elenco-recente">
      <h2>Elenco recente (<%= recentWarnings.length %><%= recentWarningsTruncated ? '+' : '' %>)</h2>
      <% if (recentWarnings.length === 0) { %>
        <p class="hint">Nessun warning registrato ancora.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Utente</th><th>Tipo</th><th>Motivo</th><th>Ruolo</th><th>Data</th><th>Emesso da</th></tr></thead>
          <tbody>
            <% recentWarnings.forEach((w) => { %>
              <tr>
                <td><%= w.userLabel %></td>
                <td><%= w.typeLabel %></td>
                <td><%= w.reason %></td>
                <td><%= w.roleLabel || '—' %></td>
                <td><%= w.dateLabel %></td>
                <td><%= w.issuedByLabel %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (recentWarningsTruncated) { %>
          <p class="hint">Elenco troncato ai 100 più recenti.</p>
        <% } %>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
