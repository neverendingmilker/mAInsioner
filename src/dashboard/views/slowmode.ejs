<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Slowmode</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/slowmode/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="canali-con-limite">
      <h2>Channels with a limit (<%= channels.length %>)</h2>
      <% if (channels.length === 0) { %>
        <p class="hint">No channels configured.</p>
      <% } else { %>
        <% channels.forEach((c) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= c.channelName %></span>
              <span class="config-meta">one message every <%= c.cooldownLabel %></span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/slowmode/add" class="form">
                      <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                      <label>
                        How often a message can be posted (e.g. 30s, 10m, 24h, 3d — minimum 1m)
                        <input type="text" name="duration" value="<%= c.cooldownSeconds %>s" required />
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/slowmode/remove" onsubmit="return confirm('Remove the limit from this channel?');">
                  <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-limite">
      <h2>Add limit</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">No text channels available.</p>
      <% } else { %>
        <form method="POST" action="/slowmode/add" class="form">
          <label>
            Channel
            <select name="channelId" required>
              <option value="" disabled selected>Choose a channel…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            How often a message can be posted (e.g. 30s, 10m, 24h, 3d — minimum 1m)
            <input type="text" name="duration" placeholder="e.g. 12h" required />
          </label>
          <button type="submit" class="btn-primary">Add limit</button>
        </form>
        <p class="hint">To limit individual threads instead of a whole channel, use <code>/slowmode add</code> on Discord.</p>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
