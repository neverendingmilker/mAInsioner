<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Anime Night</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/animenight/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <%# EXPERIMENTAL two-column layout, piloted here only (see public/style.css's
        .card-list.two-col and public/cardResize.js) — cardLayoutFraction/role/
        currentFeatureKey are res.locals set by middleware/requireAdmin.js, same as inside
        partials/featureToggle.ejs. Inline style sets the initial split server-side so the
        page never flashes the wrong ratio before cardResize.js runs. %>
    <div
      class="card-list two-col"
      id="card-list"
      data-col1-fraction="<%= cardLayoutFraction %>"
      style="--col1-fr: <%= cardLayoutFraction %>fr; --col2-fr: <%= 1 - cardLayoutFraction %>fr;"
    >
<section class="panel" data-card-id="sessioni">
      <h2>Sessioni (<%= sessions.length %>)</h2>
      <% if (sessions.length === 0) { %>
        <p class="hint">Nessuna sessione registrata.</p>
      <% } else { %>
        <% sessions.forEach((s) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name">Mystery Anime Night <%= s.number %></span>
              <span class="config-meta"><%= s.date %> — <%= s.titles.length %> anime</span>
              <form method="POST" action="/animenight/remove" onsubmit="return confirm('Rimuovere l\'intera sessione (tutti gli anime di questa data)?');">
                <input type="hidden" name="sessionDate" value="<%= s.date %>" />
                <button type="submit" class="btn-danger-sm">Rimuovi</button>
              </form>
            </div>
            <p class="config-card-subtext"><%= s.titles.join(', ') %></p>
            <details class="config-edit">
              <summary>Modifica</summary>
              <form method="POST" action="/animenight/edit" class="form">
                <input type="hidden" name="sessionDate" value="<%= s.date %>" />
                <label>
                  Titoli (separati da virgola o /)
                  <textarea name="titles" rows="2" required><%= s.titles.join(', ') %></textarea>
                </label>
                <label>
                  Data
                  <input type="date" name="date" value="<%= s.date %>" required />
                </label>
                <button type="submit" class="btn-primary-sm">Salva</button>
              </form>
            </details>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-anime">
      <h2>Aggiungi anime</h2>
      <form method="POST" action="/animenight/add" class="form">
        <label>
          Titoli (separati da virgola o /, es. "Naruto, One Piece")
          <textarea name="titles" rows="2" required placeholder="Naruto, One Piece"></textarea>
        </label>
        <label>
          Data (vuoto = oggi)
          <input type="date" name="date" />
        </label>
        <button type="submit" class="btn-primary">Aggiungi</button>
      </form>
      <p class="hint">Se la data coincide con una sessione già esistente, i titoli si aggiungono a quella invece di crearne una nuova.</p>
    </section>

<%# Explicitly grid-placed (middle column) — deliberately the LAST child here, after both
    panels, so cardReorder.js's drag logic (which only ever repositions the two .panel
    elements relative to each other) can never end up moving this out of the middle column.
    Admin-only, same convention as the other card-list controls — Mods still see the saved
    split (inline style above) but not the interactive handle. %>
<% if (typeof role !== 'undefined' && role === 'admin') { %>
  <div id="card-resize-handle" class="card-resize-handle" title="Trascina per ridimensionare le colonne"></div>
  <form id="card-layout-form" method="POST" action="/card-layout/<%= currentFeatureKey %>/resize" style="display:none;">
    <input type="hidden" id="card-layout-fraction-input" name="fraction" value="" />
  </form>
<% } %>
</div>
<script src="/cardResize.js"></script>
  </main>
</div>
<%- include('partials/footer') %>
