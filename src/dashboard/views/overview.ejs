<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <h1>Overview</h1>

    <div class="cards">
      <div class="card">
        <div class="card-label">Members</div>
        <div class="card-value"><%= guild.memberCount %></div>
      </div>
      <div class="card">
        <div class="card-label">Active features</div>
        <div class="card-value"><%= enabledCount %> / <%= totalFeatures %></div>
      </div>
      <div class="card">
        <div class="card-label">Honeypot: total kicks</div>
        <div class="card-value"><%= honeypotTotal %></div>
      </div>
      <div class="card">
        <div class="card-label">Bot uptime</div>
        <div class="card-value"><%= uptime %></div>
      </div>
    </div>

    <p class="hint">Use the sidebar to configure each feature.</p>
  </main>
</div>
<%- include('partials/footer') %>
