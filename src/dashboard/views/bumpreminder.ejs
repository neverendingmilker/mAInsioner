<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Bump Reminder</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/bumpreminder/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="stato-attuale">
      <h2>Current status</h2>
      <div class="cards">
        <div class="card">
          <div class="card-label">Next reminder</div>
          <div class="card-value" style="font-size: 16px;">
            <% if (nextReminderAt) { %>
              <span class="pill pill-accent"><%= new Date(nextReminderAt).toLocaleString('en-GB') %></span>
            <% } else { %>
              None — waiting for the next <code>/bump</code>
            <% } %>
          </div>
        </div>
        <div class="card">
          <div class="card-label">Last bumped by</div>
          <div class="card-value" style="font-size: 16px;"><%= lastBumpedBy || 'unknown' %></div>
        </div>
      </div>
      <p class="hint">The reminder is armed automatically every time Disboard confirms a <code>/bump</code>, and posted 2 hours later.</p>
    </section>

    <section class="panel" data-card-id="configurazione">
      <h2>Configuration</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">No text channels available.</p>
      <% } else { %>
        <form method="POST" action="/bumpreminder/config" class="form">
          <label>
            Channel
            <select name="channelId">
              <option value="">None</option>
              <% textChannels.forEach((c) => { %>
                <option value="<%= c.id %>" <%= config.channelId === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Role to ping (optional)
            <select name="roleId">
              <option value="">None</option>
              <% roles.forEach((r) => { %>
                <option value="<%= r.id %>" <%= config.roleId === r.id ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-primary-sm">Save configuration</button>
        </form>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
