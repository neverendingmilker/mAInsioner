<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Invite Tracker</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/invitetracker/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="canale-predefinito">
      <h2>Default channel</h2>
      <p class="hint">Where new invites created from here open (assigning an existing code doesn't use it).</p>
      <form method="POST" action="/invitetracker/channel" class="form">
        <label>
          Channel
          <select name="channelId" required>
            <option value="" disabled <%= !defaultChannelId ? 'selected' : '' %>>Choose a channel…</option>
            <% textChannels.forEach((ch) => { %>
              <option value="<%= ch.id %>" <%= ch.id === defaultChannelId ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn-primary-sm">Save</button>
      </form>
    </section>

    <section class="panel" data-card-id="classifica-top-10">
      <h2>Leaderboard (top 10)</h2>
      <% if (leaderboard.length === 0) { %>
        <p class="hint">No invites tracked yet.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>User</th><th>Currently in server</th><th>Total</th></tr></thead>
          <tbody>
            <% leaderboard.forEach((r) => { %>
              <tr><td><%= r.label %></td><td><%= r.current %></td><td><%= r.total %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

    <section class="panel" data-card-id="inviti-assegnati">
      <h2>Assigned invites (<%= assignedInvites.length %>)</h2>
      <% if (assignedInvites.length === 0) { %>
        <p class="hint">No invites assigned — or the bot is missing the "Manage Server" permission.</p>
      <% } else { %>
        <% assignedInvites.forEach((a) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= a.code %><%= a.active ? '' : ' (no longer active)' %></span>
              <span class="config-meta">
                <%= a.assignedLabel %> — <%= a.uses ?? 0 %>/<%= a.maxUses ?? '∞' %> uses<%= a.expiresLabel ? `, expires ${a.expiresLabel}` : '' %>
              </span>
              <form method="POST" action="/invitetracker/revoke" onsubmit="return confirm('Revoke this invite?');" class="card-actions">
                <input type="hidden" name="code" value="<%= a.code %>" />
                <button type="submit" class="btn-icon-sm btn-icon-danger" title="Revoke">✕</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="crea-o-assegna-un-invito">
      <h2>Create or assign an invite</h2>
      <% if (members.length === 0) { %>
        <p class="hint">No members available.</p>
      <% } else { %>
        <form method="POST" action="/invitetracker/create" class="form">
          <label>
            User to credit
            <select name="userId" required>
              <option value="" disabled selected>Choose a member…</option>
              <% members.forEach((m) => { %>
                <option value="<%= m.id %>"><%= m.label %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Existing invite code (optional — leave empty to create a new one)
            <input type="text" name="code" placeholder="e.g. abc123 or https://discord.gg/abc123" />
          </label>
          <label>
            Max uses (new invite only, empty = unlimited)
            <input type="number" name="maxUses" min="1" />
          </label>
          <label>
            Expires in hours (new invite only, empty = never, max 168)
            <input type="number" name="expiresInHours" min="1" max="168" />
          </label>
          <button type="submit" class="btn-primary">Create/assign invite</button>
        </form>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
