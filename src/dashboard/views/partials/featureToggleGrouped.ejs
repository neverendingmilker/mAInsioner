<%# EXPERIMENTAL variant of featureToggle.ejs — same four controls (on/off, Solo Admin,
    Modificabile, Riordina card), same locals, same routes/behavior, but rendered as one
    connected segmented button group instead of four separate switches: active state is
    colored (accent), inactive uses the default muted button color. Deliberately used by
    ONLY ONE page for now (Anime Night, see animenight.ejs) to try the pattern before
    rolling it out everywhere — every other feature page still includes the original
    partials/featureToggle.ejs untouched.
    Each item is still a real checkbox under the hood (hidden, same as the switches this
    replaces) — only the visual skin changes (public/style.css's .btn-group rules), so the
    exact same forms/onchange-submit/cardReorder.js logic keeps working unmodified. Active
    (colored) state is driven purely by CSS `:has(input:checked)` (same technique already
    used in channelpermissions.ejs), not a server-computed class. %>
<div class="feature-toggle-group">
  <div class="btn-group">
    <form method="POST" action="<%= toggleAction %>" class="btn-group-form">
      <label class="btn-group-item">
        <input type="checkbox" name="enabled" value="true" <%= enabled ? 'checked' : '' %> onchange="this.form.submit()" />
        <span>Attivo</span>
      </label>
    </form>

    <% if (typeof role !== 'undefined' && role === 'admin' && typeof currentFeatureKey !== 'undefined' && currentFeatureKey) { %>
      <form method="POST" action="/mod-access/<%= currentFeatureKey %>/toggle" class="btn-group-form">
        <label class="btn-group-item">
          <input type="checkbox" name="soloAdmin" value="true" <%= modAccessEnabled ? '' : 'checked' %> onchange="this.form.submit()" />
          <span>Solo Admin</span>
        </label>
      </form>
    <% } %>

    <% if (typeof role !== 'undefined' && role === 'admin' && typeof currentFeatureKey !== 'undefined' && currentFeatureKey) { %>
      <form method="POST" action="/feature-lock/<%= currentFeatureKey %>/toggle" class="btn-group-form">
        <label class="btn-group-item">
          <input type="checkbox" name="editable" value="true" <%= typeof featureLocked !== 'undefined' && featureLocked ? '' : 'checked' %> onchange="this.form.submit()" />
          <span>Modificabile</span>
        </label>
      </form>
    <% } %>

    <% if (typeof cardOrder !== 'undefined') { %>
      <script id="card-order-data" type="application/json"><%- JSON.stringify(cardOrder) %></script>
    <% } %>
    <% if (typeof role !== 'undefined' && role === 'admin' && typeof currentFeatureKey !== 'undefined' && currentFeatureKey) { %>
      <label class="btn-group-item">
        <input type="checkbox" id="card-lock-btn" />
        <span>Riordina card</span>
      </label>
      <form id="card-reorder-form" method="POST" action="/card-order/<%= currentFeatureKey %>/reorder" style="display:none;">
        <input type="hidden" id="card-order-input" name="order" value="" />
      </form>
    <% } %>
  </div>
</div>
<script src="/cardReorder.js"></script>
