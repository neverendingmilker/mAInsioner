<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Honeypot</h1>
      <form method="POST" action="/honeypot/toggle">
        <input type="hidden" name="enabled" value="<%= enabled ? 'false' : 'true' %>" />
        <button type="submit" class="badge-toggle <%= enabled ? 'on' : 'off' %>">
          <%= enabled ? '● Attivo' : '○ Disattivo' %>
        </button>
      </form>
    </div>

    <%- include('partials/flash') %>

    <section class="panel">
      <h2>Canali trappola (<%= channels.length %>)</h2>
      <% if (channels.length === 0) { %>
        <p class="hint">Nessun canale configurato.</p>
      <% } else { %>
        <% channels.forEach((c) => { %>
          <div class="trap-card">
            <div class="trap-card-header">
              <span class="trap-channel-name"><%= c.channelName %></span>
              <span class="trap-emoji" title="Emoji reazione"><%= c.emoji || '—' %></span>
              <form method="POST" action="/honeypot/remove" onsubmit="return confirm('Rimuovere la trappola da questo canale?');">
                <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                <button type="submit" class="btn-danger-sm">Rimuovi</button>
              </form>
            </div>
            <% if (c.messageMissing) { %>
              <p class="hint">⚠️ Il messaggio esca non esiste più su Discord — rimuovi e ricrea la trappola per poterla modificare.</p>
            <% } else { %>
              <details class="trap-edit">
                <summary>Modifica messaggio/bottone</summary>
                <form method="POST" action="/honeypot/edit" class="form">
                  <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                  <label>
                    Messaggio esca
                    <textarea name="message" rows="2"><%= c.messageText %></textarea>
                  </label>
                  <label>
                    Etichetta bottone
                    <input type="text" name="buttonLabel" value="<%= c.buttonLabel %>" />
                  </label>
                  <button type="submit" class="btn-primary-sm">Aggiorna nel canale</button>
                </form>
              </details>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel">
      <h2>Aggiungi trappola</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">Nessun canale testuale disponibile.</p>
      <% } else { %>
        <form method="POST" action="/honeypot/add" class="form">
          <label>
            Canale
            <select name="channelId" required>
              <option value="" disabled selected>Scegli un canale…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Messaggio esca (opzionale)
            <textarea name="message" rows="2" placeholder="<%= defaultMessage %>"></textarea>
          </label>
          <label>
            Etichetta bottone (opzionale)
            <input type="text" name="buttonLabel" placeholder="<%= defaultButtonLabel %>" />
          </label>
          <label>
            Emoji reazione (opzionale)
            <input type="text" name="emoji" placeholder="es. 🎯" />
          </label>
          <button type="submit" class="btn-primary">Crea trappola</button>
        </form>
      <% } %>
    </section>

    <section class="panel">
      <h2>Log kick — <%= kickTotal %> totali</h2>
      <% if (recentKicks.length === 0) { %>
        <p class="hint">Nessun kick registrato.</p>
      <% } else { %>
        <table class="table">
          <thead>
            <tr><th>Utente</th><th>Canale</th><th>Trigger</th><th>Quando</th></tr>
          </thead>
          <tbody>
            <% recentKicks.forEach((k) => { %>
              <tr>
                <td><%= k.userTag %></td>
                <td><%= k.channelName %></td>
                <td><%= k.trigger %></td>
                <td><%= k.when %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>
</div>
<%- include('partials/footer') %>
