<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Combined Role Search</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/comboroles/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
    <section class="panel" data-card-id="cerca-membri">
      <h2>Search members</h2>
      <p class="hint">Find who has ALL the required roles, excluding anyone who also has one of the "BUT" roles. Leave the fields you don't need empty.</p>
      <form method="GET" action="/comboroles" class="form">
        <% for (let i = 0; i < selectedRequired.length; i++) { %>
          <label>
            Required role <%= i + 1 %><%= i === 0 ? '' : ' (optional)' %>
            <select name="role<%= i + 1 %>" <%= i === 0 ? 'required' : '' %>>
              <option value="">— None —</option>
              <% roles.forEach((r) => { %>
                <option value="<%= r.id %>" <%= r.id === selectedRequired[i] ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </label>
        <% } %>
        <% for (let i = 0; i < selectedExcluded.length; i++) { %>
          <label>
            BUT: exclude anyone who also has… (optional)
            <select name="but<%= i + 1 %>">
              <option value="">— None —</option>
              <% roles.forEach((r) => { %>
                <option value="<%= r.id %>" <%= r.id === selectedExcluded[i] ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </label>
        <% } %>
        <button type="submit" class="btn-primary">Search</button>
      </form>
      <p class="hint">For more than <%= selectedRequired.length %> required roles or <%= selectedExcluded.length %> exclusions, use <code>/comboroles search</code> on Discord.</p>
    </section>

    <% if (results) { %>
      <section class="panel" data-card-id="risultati">
        <h2>Results (<%= results.total %>)</h2>
        <% if (results.total === 0) { %>
          <p class="hint">No members match the chosen criteria.</p>
        <% } else { %>
          <table class="table">
            <thead>
              <tr><th>User</th></tr>
            </thead>
            <tbody>
              <% results.shown.forEach((m) => { %>
                <tr><td><%= m.tag %></td></tr>
              <% }) %>
            </tbody>
          </table>
          <% if (results.truncated) { %>
            <p class="hint">Showing the first <%= maxResultsShown %> of <%= results.total %> results.</p>
          <% } %>
        <% } %>
      </section>
    <% } %>
    </div>
  </main>
</div>
<%- include('partials/footer') %>
