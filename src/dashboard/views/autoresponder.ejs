<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Autoresponder</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/autoresponder/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="canali-configurati">
      <h2>Configured channels (<%= channels.length %>)</h2>
      <% if (channels.length === 0) { %>
        <p class="hint">No channels configured.</p>
      <% } else { %>
        <% channels.forEach((c) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= c.channelName %></span>
              <span class="config-meta"><%= c.emojisText %></span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/autoresponder/add" class="form">
                      <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                      <label>
                        Emoji (space or comma separated)
                        <input type="text" name="emojis" value="<%= c.emojisText %>" required />
                      </label>
                      <label class="checkbox-label">
                        <input type="checkbox" name="attachment" <%= c.contentFilter.attachment ? 'checked' : '' %> />
                        Only if it has an image/gif/video attachment
                      </label>
                      <label class="checkbox-label">
                        <input type="checkbox" name="videoLink" <%= c.contentFilter.videoLink ? 'checked' : '' %> />
                        Only if it links a video (e.g. YouTube)
                      </label>
                      <label class="checkbox-label">
                        <input type="checkbox" name="xLink" <%= c.contentFilter.xLink ? 'checked' : '' %> />
                        Only if it links an X/Twitter post
                      </label>
                      <label>
                        Redirect: bot ID to wait for (optional, leave empty to disable)
                        <input type="text" name="redirectBotId" value="<%= c.redirectBotId || '' %>" />
                      </label>
                      <label>
                        Redirect: wait window in seconds (1-<%= maxRedirectWindowSeconds %>, required if the field above is filled in)
                        <input type="number" name="redirectWindowSeconds" min="1" max="<%= maxRedirectWindowSeconds %>" value="<%= c.redirectWindowSeconds || '' %>" />
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/autoresponder/remove" onsubmit="return confirm('Remove the autoresponder from this channel?');">
                  <input type="hidden" name="channelId" value="<%= c.channelId %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
            <% if (c.contentFilter.attachment || c.contentFilter.videoLink || c.contentFilter.xLink) { %>
              <p class="config-card-subtext">
                Only if:
                <% const filters = []; %>
                <% if (c.contentFilter.attachment) filters.push('has an image/gif/video attachment'); %>
                <% if (c.contentFilter.videoLink) filters.push('links a video'); %>
                <% if (c.contentFilter.xLink) filters.push('links an X/Twitter post'); %>
                <%= filters.join(', or ') %>
              </p>
            <% } %>
            <% if (c.redirectBotId) { %>
              <p class="config-card-subtext">Redirect: waits up to <%= c.redirectWindowSeconds %>s for a post from bot ID <%= c.redirectBotId %>, otherwise reacts to the original message.</p>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-autoresponder">
      <h2>Add autoresponder</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">No channels available.</p>
      <% } else { %>
        <form method="POST" action="/autoresponder/add" class="form">
          <label>
            Channel
            <select name="channelId" required>
              <option value="" disabled selected>Choose a channel…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Emoji to react with (space or comma separated, e.g. "🍕 🔥")
            <input type="text" name="emojis" placeholder="🍕" required />
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="attachment" />
            Only if it has an image/gif/video attachment
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="videoLink" />
            Only if it links a video (e.g. YouTube)
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="xLink" />
            Only if it links an X/Twitter post
          </label>
          <label>
            Redirect: bot ID to wait for (optional)
            <input type="text" name="redirectBotId" placeholder="e.g. 123456789012345678" />
          </label>
          <label>
            Redirect: wait window in seconds (1-<%= maxRedirectWindowSeconds %>, required if the field above is filled in)
            <input type="number" name="redirectWindowSeconds" min="1" max="<%= maxRedirectWindowSeconds %>" />
          </label>
          <button type="submit" class="btn-primary">Create autoresponder</button>
        </form>
        <p class="hint">Applying it to a thread or forum instead of a whole channel is still only possible via <code>/autoresponder add</code> on Discord.</p>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
