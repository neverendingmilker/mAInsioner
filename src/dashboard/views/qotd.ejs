<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Question of the Day</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/qotd/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <% if (exhausted) { %>
      <div class="flash flash-error">
        La lista di domande è esaurita — sono già state postate tutte. Il posting è in pausa finché non aggiungi altre domande.
      </div>
    <% } %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="configurazione">
      <h2>Configurazione</h2>
      <form method="POST" action="/qotd/config" class="form">
        <label>
          Canale
          <select name="channelId">
            <option value="">Nessuno</option>
            <% textChannels.forEach((c) => { %>
              <option value="<%= c.id %>" <%= config.channelId === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Ruolo da pingare (opzionale)
          <select name="roleId">
            <option value="">Nessuno</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= config.roleId === r.id ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>

        <div>
          <label class="checkbox-label">
            <input type="radio" name="scheduleMode" value="daily" id="qotd-mode-daily" <%= config.scheduleMode === 'daily' ? 'checked' : '' %> onchange="document.getElementById('qotd-daily-field').style.display='flex';document.getElementById('qotd-interval-field').style.display='none';" />
            A un orario fisso ogni giorno
          </label>
          <label class="checkbox-label">
            <input type="radio" name="scheduleMode" value="interval" id="qotd-mode-interval" <%= config.scheduleMode === 'interval' ? 'checked' : '' %> onchange="document.getElementById('qotd-daily-field').style.display='none';document.getElementById('qotd-interval-field').style.display='flex';" />
            Ogni tot ore
          </label>
        </div>

        <div class="schedule-mode-fields" id="qotd-daily-field" style="<%= config.scheduleMode === 'daily' ? '' : 'display:none;' %>">
          <label>
            Orario (fuso orario del server del bot)
            <input type="time" name="dailyTime" value="<%= config.dailyTime %>" />
          </label>
        </div>

        <div class="schedule-mode-fields" id="qotd-interval-field" style="<%= config.scheduleMode === 'interval' ? '' : 'display:none;' %>">
          <label>
            Ogni quante ore
            <input type="number" name="intervalHours" min="1" max="720" value="<%= config.intervalHours %>" />
          </label>
        </div>

        <button type="submit" class="btn-primary">Salva configurazione</button>
      </form>
    </section>

    <section class="panel" data-card-id="domande-in-coda-da-postare">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
        <h2>Domande in coda (<%= totalQuestions %>, <%= remaining %> da postare)</h2>
        <% if (questionRows.length > 0) { %>
          <form method="POST" action="/qotd/questions/clear" onsubmit="return confirm('Svuotare tutta la coda? Verranno rimosse tutte le <%= totalQuestions %> domande, azione non reversibile.');">
            <button type="submit" class="btn-danger-sm">Svuota coda</button>
          </form>
        <% } %>
      </div>
      <p class="hint">Trascina una domanda per cambiarne l'ordine — l'ordine è anche l'ordine di posting.</p>

      <% if (questionRows.length === 0) { %>
        <p class="hint">Nessuna domanda ancora — aggiungine una qui sotto.</p>
      <% } else { %>
        <div id="qotd-question-list">
          <% questionRows.forEach((q) => { %>
            <div class="qotd-question" data-id="<%= q.id %>">
              <span class="qotd-drag-handle" title="Trascina per riordinare">⠿</span>
              <div class="qotd-question-body">
                <% if (q.isNext) { %><span class="qotd-next-badge">Prossima</span><br /><% } %>
                <span class="qotd-question-text"><%= q.question %></span>
                <% if (q.source === 'sheet') { %> <span class="qotd-source-badge">(da Google Sheet)</span><% } %>
              </div>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Modifica">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/qotd/questions/<%= q.id %>/edit" class="form">
                      <label>
                        Testo
                        <textarea name="question" rows="3" required><%= q.question %></textarea>
                      </label>
                      <button type="submit" class="btn-primary-sm">Salva</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/qotd/questions/<%= q.id %>/remove" onsubmit="return confirm('Rimuovere questa domanda?');">
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Rimuovi">✕</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <form id="qotd-reorder-form" method="POST" action="/qotd/questions/reorder" style="display:none;">
        <input type="hidden" id="qotd-order-input" name="order" value="" />
      </form>
    </section>

    <section class="panel" data-card-id="aggiungi-domanda-manualmente">
      <h2>Aggiungi domanda manualmente</h2>
      <form method="POST" action="/qotd/questions/add" class="form">
        <label>
          Testo della domanda
          <textarea name="question" rows="3" required maxlength="500"></textarea>
        </label>
        <button type="submit" class="btn-primary">Aggiungi</button>
      </form>
    </section>
</div>
  </main>
</div>
<script src="/qotdReorder.js"></script>
<%- include('partials/footer') %>
