<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Role Links</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/rolelink/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="collegamenti">
      <h2>Links (<%= links.length %>)</h2>
      <% if (links.length === 0) { %>
        <p class="hint">No links configured.</p>
      <% } else { %>
        <% links.forEach((l) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= l.roleAName %> <%= l.bidirectional ? '↔' : '→' %> <%= l.roleBName %></span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/rolelink/edit" class="form">
                      <input type="hidden" name="currentRoleAId" value="<%= l.roleAId %>" />
                      <input type="hidden" name="currentRoleBId" value="<%= l.roleBId %>" />
                      <label>
                        Role 1 (when removed…)
                        <select name="roleAId" required>
                          <% roles.forEach((r) => { %>
                            <option value="<%= r.id %>" <%= r.id === l.roleAId ? 'selected' : '' %>><%= r.name %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label>
                        …Role 2 is removed too
                        <select name="roleBId" required>
                          <% roles.forEach((r) => { %>
                            <option value="<%= r.id %>" <%= r.id === l.roleBId ? 'selected' : '' %>><%= r.name %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label class="checkbox-label">
                        <input type="checkbox" name="bidirectional" <%= l.bidirectional ? 'checked' : '' %> />
                        Also applies the other way around (losing Role 2 removes Role 1 too)
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/rolelink/remove" onsubmit="return confirm('Remove this link?');">
                  <input type="hidden" name="roleAId" value="<%= l.roleAId %>" />
                  <input type="hidden" name="roleBId" value="<%= l.roleBId %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-collegamento">
      <h2>Add link</h2>
      <% if (roles.length < 2) { %>
        <p class="hint">You need at least two assignable roles in the server to create a link.</p>
      <% } else { %>
        <form method="POST" action="/rolelink/add" class="form">
          <label>
            Role 1 (when removed…)
            <select name="roleAId" required>
              <option value="" disabled selected>Choose a role…</option>
              <% roles.forEach((r) => { %>
                <option value="<%= r.id %>"><%= r.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            …Role 2 is removed too
            <select name="roleBId" required>
              <option value="" disabled selected>Choose a role…</option>
              <% roles.forEach((r) => { %>
                <option value="<%= r.id %>"><%= r.name %></option>
              <% }) %>
            </select>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="bidirectional" />
            Also applies the other way around (losing Role 2 removes Role 1 too)
          </label>
          <button type="submit" class="btn-primary">Create link</button>
        </form>
        <p class="hint">To link Role 1 to multiple roles at once, use <code>/rolelink add</code> on Discord.</p>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
