<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Sticky Messages</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/sticky/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <section class="panel">
      <h2>Canali con messaggio persistente (<%= stickies.length %>)</h2>
      <% if (stickies.length === 0) { %>
        <p class="hint">Nessun canale configurato.</p>
      <% } else { %>
        <% stickies.forEach((s) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= s.channelName %></span>
              <span class="config-meta">riappare dopo <%= s.repostDelayLabel %> di inattività</span>
              <form method="POST" action="/sticky/remove" onsubmit="return confirm('Rimuovere il messaggio persistente da questo canale?');">
                <input type="hidden" name="channelId" value="<%= s.channelId %>" />
                <button type="submit" class="btn-danger-sm">Rimuovi</button>
              </form>
            </div>
            <details class="config-edit">
              <summary>Modifica</summary>
              <form method="POST" action="/sticky/add" class="form">
                <input type="hidden" name="channelId" value="<%= s.channelId %>" />
                <label>
                  Messaggio
                  <textarea name="content" rows="3" maxlength="4000" required><%= s.content %></textarea>
                </label>
                <label>
                  Ritardo prima di riapparire (es. 30s, 1m, 2m)
                  <input type="text" name="delay" value="<%= s.repostDelaySeconds %>s" required />
                </label>
                <button type="submit" class="btn-primary-sm">Salva</button>
              </form>
              <p class="hint">Salvare cancella il vecchio messaggio e ne posta uno nuovo — l'operazione può richiedere qualche secondo.</p>
            </details>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel">
      <h2>Aggiungi messaggio persistente</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">Nessun canale testuale disponibile.</p>
      <% } else { %>
        <form method="POST" action="/sticky/add" class="form">
          <label>
            Canale
            <select name="channelId" required>
              <option value="" disabled selected>Scegli un canale…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Messaggio
            <textarea name="content" rows="3" maxlength="4000" required></textarea>
          </label>
          <label>
            Ritardo prima di riapparire (opzionale, default <%= defaultDelaySeconds %>s) — es. 30s, 1m, 2m
            <input type="text" name="delay" placeholder="<%= defaultDelaySeconds %>s" />
          </label>
          <button type="submit" class="btn-primary">Crea messaggio persistente</button>
        </form>
        <p class="hint">Applicarlo a un singolo thread invece che a un canale intero resta possibile solo via <code>/sticky add</code> su Discord.</p>
      <% } %>
    </section>
  </main>
</div>
<%- include('partials/footer') %>
