<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Birthday</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/birthday/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="configurazione">
      <h2>Configuration</h2>
      <form method="POST" action="/birthday/config" class="form">
        <label>
          Birthday role (assigned on the day of the birthday)
          <select name="roleId">
            <option value="">— None —</option>
            <% roles.forEach((r) => { %>
              <option value="<%= r.id %>" <%= r.id === config.roleId ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Remove the role after (e.g. 30s, 10m, 24h, 3d — min 10s, max 30d)
          <input type="text" name="removeAfter" placeholder="<%= config.removeAfterLabel %>" />
        </label>
        <label>
          Greetings channel
          <select name="channelId">
            <option value="">— None —</option>
            <% textChannels.forEach((ch) => { %>
              <option value="<%= ch.id %>" <%= ch.id === config.channelId ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
        </label>
        <p class="hint">Each field is independent — leave empty/on "None" whatever you don't want to change.</p>
        <button type="submit" class="btn-primary-sm">Save</button>
      </form>
    </section>

    <section class="panel" data-card-id="compleanni-salvati">
      <h2>Saved birthdays</h2>
      <% if (monthGroups.length === 0) { %>
        <p class="hint">No birthdays saved.</p>
      <% } else { %>
        <% monthGroups.forEach((g) => { %>
          <h3 class="month-heading"><%= g.monthLabel %></h3>
          <% g.entries.forEach((e) => { %>
            <div class="config-card">
              <div class="config-card-header">
                <span class="config-name"><%= e.userLabel %></span>
                <span class="config-meta"><%= e.day %>/<%= e.month %><% if (e.year) { %>/<%= e.year %><% } %></span>
                <span class="config-meta"><%= e.daysUntilLabel %></span>
                <div class="card-actions">
                  <% if (e.memberPresent) { %>
                    <details>
                      <summary class="btn-icon-sm" title="Edit">✎</summary>
                      <div class="card-edit-popover">
                        <form method="POST" action="/birthday/add" class="form">
                          <input type="hidden" name="userId" value="<%= e.userId %>" />
                          <label>
                            Day
                            <input type="number" name="day" min="1" max="31" value="<%= e.day %>" required />
                          </label>
                          <label>
                            Month
                            <input type="number" name="month" min="1" max="12" value="<%= e.month %>" required />
                          </label>
                          <label>
                            Year (optional)
                            <input type="number" name="year" min="1900" max="<%= new Date().getFullYear() %>" value="<%= e.year || '' %>" />
                          </label>
                          <button type="submit" class="btn-primary-sm">Save</button>
                        </form>
                      </div>
                    </details>
                  <% } %>
                  <form method="POST" action="/birthday/remove" onsubmit="return confirm('Remove this birthday?');">
                    <input type="hidden" name="userId" value="<%= e.userId %>" />
                    <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                  </form>
                </div>
              </div>
              <% if (!e.memberPresent) { %>
                <p class="config-card-subtext">This user is no longer in the server — the date can't be edited, but you can still remove the entry.</p>
              <% } %>
            </div>
          <% }) %>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-aggiorna-compleanno">
      <h2>Add / update birthday</h2>
      <% if (members.length === 0) { %>
        <p class="hint">No members available.</p>
      <% } else { %>
        <form method="POST" action="/birthday/add" class="form">
          <label>
            User
            <select name="userId" required>
              <option value="" disabled selected>Choose a user…</option>
              <% members.forEach((m) => { %>
                <option value="<%= m.id %>"><%= m.label %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Day
            <input type="number" name="day" min="1" max="31" required />
          </label>
          <label>
            Month
            <input type="number" name="month" min="1" max="12" required />
          </label>
          <label>
            Year (optional)
            <input type="number" name="year" min="1900" max="<%= new Date().getFullYear() %>" />
          </label>
          <button type="submit" class="btn-primary">Add/update</button>
        </form>
      <% } %>
    </section>
</div>
  </main>
</div>
<%- include('partials/footer') %>
