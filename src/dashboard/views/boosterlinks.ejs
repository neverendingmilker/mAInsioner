<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Booster Links</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/boosterlinks/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <section class="panel">
      <h2>Ruoli collegati (<%= links.length %>)</h2>
      <% if (links.length === 0) { %>
        <p class="hint">Nessun ruolo personalizzato collegato a un booster.</p>
      <% } else { %>
        <% links.forEach((l) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= l.userLabel %></span>
              <span class="config-meta"><%= l.roleLabel %><%= l.isBooster ? '' : ' — non sta più boostando' %></span>
              <form method="POST" action="/boosterlinks/remove" onsubmit="return confirm('Smettere di tracciare questo ruolo? Il ruolo non verrà rimosso dall\'utente.');">
                <input type="hidden" name="userId" value="<%= l.userId %>" />
                <input type="hidden" name="roleId" value="<%= l.roleId %>" />
                <button type="submit" class="btn-danger-sm">Rimuovi</button>
              </form>
            </div>
            <% if (roles.length > 0) { %>
              <details class="config-edit">
                <summary>Modifica</summary>
                <form method="POST" action="/boosterlinks/edit" class="form">
                  <input type="hidden" name="userId" value="<%= l.userId %>" />
                  <input type="hidden" name="oldRoleId" value="<%= l.roleId %>" />
                  <label>
                    Nuovo ruolo da tracciare al posto di quello attuale
                    <select name="newRoleId" required>
                      <% roles.forEach((r) => { %>
                        <option value="<%= r.id %>" <%= r.id === l.roleId ? 'selected' : '' %>><%= r.name %></option>
                      <% }) %>
                    </select>
                  </label>
                  <button type="submit" class="btn-primary-sm">Salva</button>
                </form>
              </details>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel">
      <h2>Aggiungi collegamento</h2>
      <% if (members.length === 0 || roles.length === 0) { %>
        <p class="hint">Servono almeno un membro e un ruolo assegnabile.</p>
      <% } else { %>
        <form method="POST" action="/boosterlinks/add" class="form">
          <label>
            Utente
            <select name="userId" required>
              <option value="" disabled selected>Scegli un membro…</option>
              <% members.forEach((m) => { %>
                <option value="<%= m.id %>"><%= m.label %><%= m.isBooster ? ' (booster)' : '' %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Ruolo personalizzato da collegare
            <select name="roleId" required>
              <option value="" disabled selected>Scegli un ruolo…</option>
              <% roles.forEach((r) => { %>
                <option value="<%= r.id %>"><%= r.name %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-primary">Aggiungi collegamento</button>
        </form>
        <p class="hint">Il ruolo del bot deve essere più in alto di quello scelto, altrimenti non potrà rimuoverlo in seguito.</p>
      <% } %>
    </section>

    <section class="panel">
      <h2>Ruoli esenti (<%= exemptRoles.length %>)</h2>
      <p class="hint">I membri con uno qualsiasi di questi ruoli non vengono mai toccati dalla rimozione automatica, indipendentemente dal boost.</p>
      <% if (exemptRoles.length === 0) { %>
        <p class="hint">Nessun ruolo esente configurato.</p>
      <% } else { %>
        <% exemptRoles.forEach((r) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= r.name %></span>
              <form method="POST" action="/boosterlinks/exempt/remove" onsubmit="return confirm('Rimuovere questo ruolo dagli esenti?');">
                <input type="hidden" name="roleId" value="<%= r.id %>" />
                <button type="submit" class="btn-danger-sm">Rimuovi</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
      <% if (allRoles.length > 0) { %>
        <form method="POST" action="/boosterlinks/exempt/add" class="form">
          <label>
            Aggiungi ruolo esente
            <select name="roleId" required>
              <option value="" disabled selected>Scegli un ruolo…</option>
              <% allRoles.forEach((r) => { %>
                <option value="<%= r.id %>"><%= r.name %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-primary">Aggiungi ruolo esente</button>
        </form>
      <% } %>
    </section>
  </main>
</div>
<%- include('partials/footer') %>
