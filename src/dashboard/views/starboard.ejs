<%- include('partials/head') %>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="content">
    <div class="page-header">
      <h1>Starboard</h1>
      <%- include('partials/featureToggle', { enabled, toggleAction: '/starboard/toggle' }) %>
    </div>

    <%- include('partials/flash') %>

    <div class="card-list" id="card-list">
<section class="panel" data-card-id="starboard">
      <h2>Starboard (<%= boards.length %>)</h2>
      <!-- Il lookback parte in background nello stesso processo del bot: la richiesta
           POST torna subito, la scansione vera e propria continua dopo — vedi
           /starboard/lookback e /starboard/lookback/status, starboardLookback.js. -->
      <% if (boards.length === 0) { %>
        <p class="hint">No starboards configured.</p>
      <% } else { %>
        <% boards.forEach((b) => { %>
          <div class="config-card">
            <div class="config-card-header">
              <span class="config-name"><%= b.name %></span>
              <span class="config-meta">
                <%= b.watchChannelLabel %> → <%= b.postChannelLabel %>, threshold <%= b.threshold %>+,
                <%= b.emojisDisplay %>, filter: <%= b.contentTypeLabel %>
              </span>
              <div class="card-actions">
                <details>
                  <summary class="btn-icon-sm" title="Lookback (scan recent messages)">🔍</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/starboard/lookback" class="form">
                      <input type="hidden" name="name" value="<%= b.name %>" />
                      <label>
                        Messages to scan per channel (ignored if you choose a start date)
                        <input type="number" name="limit" min="1" max="<%= lookbackMaxLimit %>" value="<%= lookbackDefaultLimit %>" />
                      </label>
                      <label>
                        Scan start
                        <select name="sinceMode">
                          <option value="none">Just the last N messages (above)</option>
                          <option value="year_start">From the start of the year</option>
                          <option value="date">From a specific date</option>
                        </select>
                      </label>
                      <label>
                        Start date (only if "From a specific date", DD/MM/YYYY)
                        <input type="text" name="sinceDate" placeholder="15/03/2025" />
                      </label>
                      <label>
                        End date, optional (DD/MM/YYYY, includes that whole day)
                        <input type="text" name="untilDate" placeholder="20/03/2025" />
                      </label>
                      <label>
                        Content filter for this scan (optional, otherwise uses the starboard's)
                        <select name="contentType">
                          <option value="">Use the starboard's filter (<%= b.contentTypeLabel %>)</option>
                          <% Object.entries(contentTypes).forEach(([value, label]) => { %>
                            <option value="<%= value %>"><%= label %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label>
                        Emoji for this scan (optional, otherwise uses the starboard's)
                        <input type="text" name="emojis" placeholder="<%= b.emojisRaw %>" />
                      </label>
                      <label>
                        Threshold for this scan (optional, otherwise <%= b.threshold %>)
                        <input type="number" name="threshold" min="<%= minThreshold %>" max="<%= maxThreshold %>" />
                      </label>
                      <% if (b.extraChannelChoices.length > 0) { %>
                        <fieldset>
                          <legend>Additional channels to scan (besides <%= b.watchChannelLabel %>, max <%= maxLookbackChannels - 1 %>)</legend>
                          <% b.extraChannelChoices.forEach((ch) => { %>
                            <label class="checkbox-label">
                              <input type="checkbox" name="extraChannelIds" value="<%= ch.id %>" />
                              <%= ch.name %>
                            </label>
                          <% }) %>
                        </fieldset>
                      <% } %>
                      <button type="submit" class="btn-primary-sm">Start scan</button>
                    </form>
                  </div>
                </details>
                <details>
                  <summary class="btn-icon-sm" title="Edit">✎</summary>
                  <div class="card-edit-popover">
                    <form method="POST" action="/starboard/edit" class="form">
                      <input type="hidden" name="name" value="<%= b.name %>" />
                      <label>
                        Watch channel
                        <select name="watchChannelId" required>
                          <% textChannels.forEach((ch) => { %>
                            <option value="<%= ch.id %>" <%= b.watchChannelId === ch.id ? 'selected' : '' %>><%= ch.name %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label>
                        Post channel
                        <select name="postChannelId" required>
                          <% textChannels.forEach((ch) => { %>
                            <option value="<%= ch.id %>" <%= b.postChannelId === ch.id ? 'selected' : '' %>><%= ch.name %></option>
                          <% }) %>
                        </select>
                      </label>
                      <label>
                        Reaction threshold
                        <input type="number" name="threshold" min="<%= minThreshold %>" max="<%= maxThreshold %>" value="<%= b.threshold %>" required />
                      </label>
                      <label>
                        Emoji (up to <%= maxEmojis %>, or "any" for any emoji)
                        <input type="text" name="emojis" value="<%= b.emojisRaw %>" required />
                      </label>
                      <label>
                        Content type
                        <select name="contentType" required>
                          <% Object.entries(contentTypes).forEach(([value, label]) => { %>
                            <option value="<%= value %>" <%= b.contentType === value ? 'selected' : '' %>><%= label %></option>
                          <% }) %>
                        </select>
                      </label>
                      <button type="submit" class="btn-primary-sm">Save</button>
                    </form>
                  </div>
                </details>
                <form method="POST" action="/starboard/remove" onsubmit="return confirm('Remove this starboard?');">
                  <input type="hidden" name="name" value="<%= b.name %>" />
                  <button type="submit" class="btn-icon-sm btn-icon-danger" title="Remove">✕</button>
                </form>
              </div>
            </div>
            <div
              class="lookback-status config-card-subtext"
              data-board-name="<%= b.name %>"
              data-status="<%= b.lookback ? b.lookback.status : '' %>"
              <%= b.lookback ? '' : 'hidden' %>
            >
              <span class="lookback-status-text">
                <% if (b.lookback) { %>
                  <% if (b.lookback.status === 'running') { %>
                    🔍 Scan in progress… <%= b.lookback.scanned %> messages checked, <%= b.lookback.qualified %> added so far (<%= b.lookback.channelsScanned %> channels).
                  <% } else if (b.lookback.status === 'done') { %>
                    ✅ Scan complete: <%= b.lookback.scanned %> messages checked, <%= b.lookback.qualified %> added to the starboard<%= b.lookback.errors > 0 ? ` (${b.lookback.errors} with errors)` : '' %>.
                  <% } else if (b.lookback.status === 'error') { %>
                    ⚠️ Scan interrupted: <%= b.lookback.errorMessage %>
                  <% } %>
                <% } %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel" data-card-id="aggiungi-starboard">
      <h2>Add starboard</h2>
      <% if (textChannels.length === 0) { %>
        <p class="hint">No channels available.</p>
      <% } else { %>
        <form method="POST" action="/starboard/add" class="form">
          <label>
            Name (identifies the starboard)
            <input type="text" name="name" required />
          </label>
          <label>
            Watch channel
            <select name="watchChannelId" required>
              <option value="" disabled selected>Choose…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Post channel
            <select name="postChannelId" required>
              <option value="" disabled selected>Choose…</option>
              <% textChannels.forEach((ch) => { %>
                <option value="<%= ch.id %>"><%= ch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Reaction threshold
            <input type="number" name="threshold" min="<%= minThreshold %>" max="<%= maxThreshold %>" value="3" required />
          </label>
          <label>
            Emoji (up to <%= maxEmojis %>, e.g. "⭐" or "any" for any emoji)
            <input type="text" name="emojis" placeholder="⭐" required />
          </label>
          <label>
            Content type
            <select name="contentType" required>
              <% Object.entries(contentTypes).forEach(([value, label]) => { %>
                <option value="<%= value %>" <%= value === 'any' ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-primary">Add starboard</button>
        </form>
      <% } %>
    </section>
</div>
  </main>
</div>
<script src="/starboardLookback.js"></script>
<%- include('partials/footer') %>
