<aside class="sidebar">
  <div class="brand">mAInsioner</div>

  <% if (typeof guild !== 'undefined' && guild) { %>
  <div class="guild-card">
    <% if (guild.iconURL) { %><img src="<%= guild.iconURL %>" alt="" class="guild-icon" /><% } %>
    <span class="guild-name"><%= guild.name %></span>
  </div>
  <% if (typeof guildAccess !== 'undefined' && guildAccess.length > 1) { %>
    <a class="change-server" href="/select-server">Cambia server</a>
  <% } %>
  <% } %>

  <% const canReorderSidebar = typeof role !== 'undefined' && role === 'admin'; %>
  <nav class="nav">
    <a class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'overview' ? 'active' : '' %>" href="/">Overview</a>
    <div class="nav-section-header">
      <div class="nav-section">Feature</div>
      <% if (canReorderSidebar) { %>
        <button type="button" id="sidebar-lock-btn" class="sidebar-lock-btn" data-locked="true" title="Sblocca per riordinare le sezioni">🔒</button>
      <% } %>
    </div>
    <div class="nav-feature-list" id="sidebar-feature-list">
      <% features.forEach((f) => { %>
        <div class="nav-item" data-key="<%= f.key %>">
          <% if (canReorderSidebar) { %><span class="nav-drag-handle" title="Trascina per riordinare">⠿</span><% } %>
          <% if (f.href) { %>
            <a class="nav-link <%= f.active ? 'active' : '' %>" href="<%= f.href %>"><%= f.label %></a>
          <% } else { %>
            <div class="nav-link disabled" title="Presto disponibile"><%= f.label %></div>
          <% } %>
        </div>
      <% }) %>
    </div>
    <% if (canReorderSidebar) { %>
      <form id="sidebar-reorder-form" method="POST" action="/sidebar-order/reorder" style="display:none;">
        <input type="hidden" id="sidebar-order-input" name="order" value="" />
      </form>
    <% } %>
    <% if (typeof tools !== 'undefined' && tools.length > 0) { %>
      <div class="nav-section">Strumenti</div>
      <% tools.forEach((t) => { %>
        <a class="nav-link <%= t.active ? 'active' : '' %>" href="<%= t.href %>"><%= t.label %></a>
      <% }) %>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <% if (user.avatarURL) { %><img src="<%= user.avatarURL %>" alt="" class="user-avatar" /><% } %>
    <span class="user-name"><%= user.username %></span>
    <a class="logout" href="/logout">Esci</a>
  </div>
</aside>
<% if (canReorderSidebar) { %><script src="/sidebarReorder.js"></script><% } %>
